---
import PageLayout from './PageLayout.astro';
import Breadcrumbs from '../components/common/Breadcrumbs.astro';
import ContactForm from '../components/forms/ContactForm.astro';
import FAQAccordion from '../components/sections/FAQAccordion.astro';
import CTASection from '../components/sections/CTASection.astro';
import ServiceCards from '../components/sections/ServiceCards.astro';
import AttorneySidebarCard from '../components/ui/AttorneySidebarCard.astro';
import { Phone, ArrowRight, Check } from '@lucide/astro';

interface FAQ {
  question: string;
  answer: string;
}

interface Props {
  title: string;
  description: string;
  heroTitle: string;
  heroDescription?: string;
  category: 'personal-injury' | 'criminal-defense';
  faqs?: FAQ[];
  relatedServices?: { title: string; href: string; description: string; icon: string; slug: string; category: string; }[];
  breadcrumbs: { label: string; href?: string }[];
}

const { 
  title, 
  description, 
  heroTitle,
  heroDescription,
  category,
  faqs = [],
  relatedServices = [],
  breadcrumbs
} = Astro.props;

const categoryLabel = category === 'personal-injury' ? 'Personal Injury' : 'Criminal Defense';
const categoryHref = category === 'personal-injury' ? '/personal-injury/' : '/criminal-defense/';
---

<PageLayout title={title} description={description}>
  <!-- Breadcrumbs -->
  <Breadcrumbs items={breadcrumbs} />
  
  <!-- Hero Section -->
  <section class="bg-gradient-animated text-white py-12 md:py-16 relative overflow-hidden">
    <!-- Decorative Elements -->
    <div class="absolute inset-0 bg-pattern-grid-light opacity-20"></div>
    <div class="absolute top-10 right-10 w-64 h-64 rounded-full bg-gold-500/10 blur-3xl"></div>
    <div class="absolute bottom-0 left-0 w-96 h-96 rounded-full bg-navy-500/30 blur-3xl -translate-x-1/2 translate-y-1/2"></div>
    
    <div class="container-custom relative">
      <div class="grid lg:grid-cols-2 gap-12 items-start">
        <div>
          <span class="inline-flex items-center gap-2 px-4 py-1.5 bg-gold-500/20 text-gold-400 text-sm font-medium rounded-full mb-4 border border-gold-500/30">
            <span class="w-2 h-2 bg-gold-400 rounded-full animate-pulse"></span>
            {categoryLabel}
          </span>
          <h1 class="font-heading font-bold text-white mb-4">{heroTitle}</h1>
          {heroDescription && (
            <p class="text-xl text-gray-300 mb-6">{heroDescription}</p>
          )}
          
          <div class="flex flex-wrap gap-3 mb-8">
            <div class="flex items-center gap-2 bg-white/5 backdrop-blur-sm px-3 py-1.5 rounded-full border border-white/10">
              <Check class="w-4 h-4 text-gold-500" />
              <span class="text-gray-200 text-sm">Free Consultation</span>
            </div>
            <div class="flex items-center gap-2 bg-white/5 backdrop-blur-sm px-3 py-1.5 rounded-full border border-white/10">
              <Check class="w-4 h-4 text-gold-500" />
              <span class="text-gray-200 text-sm">No Fee Unless We Win</span>
            </div>
            <div class="flex items-center gap-2 bg-white/5 backdrop-blur-sm px-3 py-1.5 rounded-full border border-white/10">
              <Check class="w-4 h-4 text-gold-500" />
              <span class="text-gray-200 text-sm">Available 24/7</span>
            </div>
          </div>
          
          <div class="flex flex-wrap gap-4">
            <a href="/contact-us/" class="btn btn-primary btn-glow shadow-elevated">
              Free Case Review
              <ArrowRight class="w-5 h-5" />
            </a>
            <a href="tel:+14104840400" class="btn btn-outline">
              <Phone class="w-5 h-5" />
              (410) 484-0400
            </a>
          </div>
        </div>
        
        <!-- Contact Form -->
        <div class="relative">
          <div class="absolute -inset-2 bg-gold-500/20 rounded-3xl blur-xl"></div>
          <div class="relative bg-white rounded-2xl p-6 md:p-8 shadow-floating">
            <ContactForm 
              title="Get Your Free Case Evaluation"
              subtitle="Tell us about your case and we'll get back to you within 24 hours."
              variant="default"
              showPhone={false}
            />
          </div>
        </div>
      </div>
    </div>
    
    <!-- Bottom Gradient Line -->
    <div class="absolute bottom-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-gold-500/50 to-transparent"></div>
  </section>
  
  <!-- Main Content -->
  <section class="section-padding relative">
    <div class="absolute inset-0 bg-pattern-dots opacity-20"></div>
    <div class="container-custom relative">
      <div class="grid lg:grid-cols-3 gap-12">
        <!-- Main Content Area -->
        <div class="lg:col-span-2 prose max-w-none">
          <slot />
        </div>
        
        <!-- Sidebar -->
        <aside class="space-y-6">
          <!-- Attorney Card -->
          <AttorneySidebarCard />
          
          <!-- Trust Badges -->
          <div class="bg-white rounded-xl p-6 shadow-soft border border-gray-100">
            <h3 class="font-heading font-bold text-navy-900 mb-4">Why Choose Us</h3>
            <ul class="space-y-3">
              <li class="flex items-start gap-3">
                <div class="w-6 h-6 bg-gold-500/10 rounded-full flex items-center justify-center flex-shrink-0">
                  <Check class="w-4 h-4 text-gold-600" />
                </div>
                <span class="text-sm text-gray-700">26+ years of experience</span>
              </li>
              <li class="flex items-start gap-3">
                <div class="w-6 h-6 bg-gold-500/10 rounded-full flex items-center justify-center flex-shrink-0">
                  <Check class="w-4 h-4 text-gold-600" />
                </div>
                <span class="text-sm text-gray-700">Hundreds of successful cases</span>
              </li>
              <li class="flex items-start gap-3">
                <div class="w-6 h-6 bg-gold-500/10 rounded-full flex items-center justify-center flex-shrink-0">
                  <Check class="w-4 h-4 text-gold-600" />
                </div>
                <span class="text-sm text-gray-700">No fee unless we win</span>
              </li>
              <li class="flex items-start gap-3">
                <div class="w-6 h-6 bg-gold-500/10 rounded-full flex items-center justify-center flex-shrink-0">
                  <Check class="w-4 h-4 text-gold-600" />
                </div>
                <span class="text-sm text-gray-700">Multilingual staff</span>
              </li>
              <li class="flex items-start gap-3">
                <div class="w-6 h-6 bg-gold-500/10 rounded-full flex items-center justify-center flex-shrink-0">
                  <Check class="w-4 h-4 text-gold-600" />
                </div>
                <span class="text-sm text-gray-700">Personalized attention</span>
              </li>
            </ul>
          </div>
        </aside>
      </div>
    </div>
  </section>
  
  <!-- FAQ Section -->
  {faqs.length > 0 && (
    <div class="bg-gray-50">
      <FAQAccordion 
        faqs={faqs}
        title="Frequently Asked Questions"
        subtitle={`Common questions about ${categoryLabel.toLowerCase()} cases`}
      />
    </div>
  )}
  
  <!-- Related Services -->
  {relatedServices.length > 0 && (
    <ServiceCards 
      services={relatedServices}
      title="Related Practice Areas"
      subtitle="We can also help with"
      columns={3}
      showDescription={true}
    />
  )}
  
  <!-- CTA -->
  <CTASection 
    title="Get the Legal Help You Deserve"
    description="Don't wait to get the representation you need. Contact us today for a free, confidential case evaluation."
    variant="centered"
  />
</PageLayout>
