---
import PageLayout from './PageLayout.astro';
import Breadcrumbs from '../components/common/Breadcrumbs.astro';
import ContactForm from '../components/forms/ContactForm.astro';
import FAQAccordion from '../components/sections/FAQAccordion.astro';
import CTASection from '../components/sections/CTASection.astro';
import ServiceCards from '../components/sections/ServiceCards.astro';
import { Phone, ArrowRight, Check } from '@lucide/astro';

interface FAQ {
  question: string;
  answer: string;
}

interface Props {
  title: string;
  description: string;
  heroTitle: string;
  heroDescription?: string;
  category: 'personal-injury' | 'criminal-defense';
  faqs?: FAQ[];
  relatedServices?: { title: string; href: string; description: string; icon: string; slug: string; category: string; }[];
  breadcrumbs: { label: string; href?: string }[];
}

const { 
  title, 
  description, 
  heroTitle,
  heroDescription,
  category,
  faqs = [],
  relatedServices = [],
  breadcrumbs
} = Astro.props;

const categoryLabel = category === 'personal-injury' ? 'Personal Injury' : 'Criminal Defense';
const categoryHref = category === 'personal-injury' ? '/personal-injury/' : '/criminal-defense/';
---

<PageLayout title={title} description={description}>
  <!-- Breadcrumbs -->
  <Breadcrumbs items={breadcrumbs} />
  
  <!-- Hero Section -->
  <section class="bg-gradient-navy text-white py-12 md:py-16">
    <div class="container-custom">
      <div class="grid lg:grid-cols-2 gap-12 items-start">
        <div>
          <span class="inline-block px-3 py-1 bg-gold-500/20 text-gold-400 text-sm font-medium rounded-full mb-4">
            {categoryLabel}
          </span>
          <h1 class="font-heading font-bold text-white mb-4">{heroTitle}</h1>
          {heroDescription && (
            <p class="text-xl text-gray-300 mb-6">{heroDescription}</p>
          )}
          
          <div class="flex flex-wrap gap-4 mb-8">
            <div class="flex items-center gap-2">
              <Check class="w-5 h-5 text-gold-500" />
              <span class="text-gray-200">Free Consultation</span>
            </div>
            <div class="flex items-center gap-2">
              <Check class="w-5 h-5 text-gold-500" />
              <span class="text-gray-200">No Fee Unless We Win</span>
            </div>
            <div class="flex items-center gap-2">
              <Check class="w-5 h-5 text-gold-500" />
              <span class="text-gray-200">Available 24/7</span>
            </div>
          </div>
          
          <div class="flex flex-wrap gap-4">
            <a href="/contact-us/" class="btn btn-primary">
              Free Case Review
              <ArrowRight class="w-5 h-5" />
            </a>
            <a href="tel:+14104840400" class="btn btn-outline">
              <Phone class="w-5 h-5" />
              (410) 484-0400
            </a>
          </div>
        </div>
        
        <!-- Contact Form -->
        <div class="bg-white rounded-2xl p-6 md:p-8 shadow-2xl">
          <ContactForm 
            title="Get Your Free Case Evaluation"
            subtitle="Tell us about your case and we'll get back to you within 24 hours."
            variant="default"
            showPhone={false}
          />
        </div>
      </div>
    </div>
  </section>
  
  <!-- Main Content -->
  <section class="section-padding">
    <div class="container-custom">
      <div class="grid lg:grid-cols-3 gap-12">
        <!-- Main Content Area -->
        <div class="lg:col-span-2 prose max-w-none">
          <slot />
        </div>
        
        <!-- Sidebar -->
        <aside class="space-y-6">
          <!-- Quick Contact Card -->
          <div class="bg-navy-900 text-white rounded-xl p-6">
            <h3 class="font-heading font-bold text-lg mb-4">Need Help Now?</h3>
            <p class="text-gray-300 text-sm mb-4">
              Call us 24/7 for a free consultation. We're here to help.
            </p>
            <a 
              href="tel:+14104840400" 
              class="btn btn-primary w-full"
            >
              <Phone class="w-5 h-5" />
              (410) 484-0400
            </a>
          </div>
          
          <!-- Trust Badges -->
          <div class="bg-gray-50 rounded-xl p-6 border border-gray-200">
            <h3 class="font-heading font-bold text-navy-900 mb-4">Why Choose Us</h3>
            <ul class="space-y-3">
              <li class="flex items-start gap-3">
                <Check class="w-5 h-5 text-gold-500 flex-shrink-0 mt-0.5" />
                <span class="text-sm text-gray-700">26+ years of experience</span>
              </li>
              <li class="flex items-start gap-3">
                <Check class="w-5 h-5 text-gold-500 flex-shrink-0 mt-0.5" />
                <span class="text-sm text-gray-700">Hundreds of successful cases</span>
              </li>
              <li class="flex items-start gap-3">
                <Check class="w-5 h-5 text-gold-500 flex-shrink-0 mt-0.5" />
                <span class="text-sm text-gray-700">No fee unless we win</span>
              </li>
              <li class="flex items-start gap-3">
                <Check class="w-5 h-5 text-gold-500 flex-shrink-0 mt-0.5" />
                <span class="text-sm text-gray-700">Multilingual staff</span>
              </li>
              <li class="flex items-start gap-3">
                <Check class="w-5 h-5 text-gold-500 flex-shrink-0 mt-0.5" />
                <span class="text-sm text-gray-700">Personalized attention</span>
              </li>
            </ul>
          </div>
        </aside>
      </div>
    </div>
  </section>
  
  <!-- FAQ Section -->
  {faqs.length > 0 && (
    <div class="bg-gray-50">
      <FAQAccordion 
        faqs={faqs}
        title="Frequently Asked Questions"
        subtitle={`Common questions about ${categoryLabel.toLowerCase()} cases`}
      />
    </div>
  )}
  
  <!-- Related Services -->
  {relatedServices.length > 0 && (
    <ServiceCards 
      services={relatedServices}
      title="Related Practice Areas"
      subtitle="We can also help with"
      columns={3}
      showDescription={true}
    />
  )}
  
  <!-- CTA -->
  <CTASection 
    title="Get the Legal Help You Deserve"
    description="Don't wait to get the representation you need. Contact us today for a free, confidential case evaluation."
    variant="centered"
  />
</PageLayout>
