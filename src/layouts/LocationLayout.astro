---
import PageLayout from './PageLayout.astro';
import Breadcrumbs from '../components/common/Breadcrumbs.astro';
import ContactForm from '../components/forms/ContactForm.astro';
import ServiceCards from '../components/sections/ServiceCards.astro';
import CTASection from '../components/sections/CTASection.astro';
import AttorneySidebarCard from '../components/ui/AttorneySidebarCard.astro';
import { Phone, ArrowRight, MapPin, Building, Clock, Check } from '@lucide/astro';
import { featuredServices } from '../data/services';
import type { Location } from '../data/locations';

interface Props {
  location: Location;
  title: string;
  description: string;
}

const { location, title, description } = Astro.props;

const breadcrumbs = [
  { label: 'Areas Served', href: '/areas-served/' },
  { label: location.name }
];
---

<PageLayout title={title} description={description}>
  <Breadcrumbs items={breadcrumbs} />
  
  <!-- Hero Section -->
  <section class="bg-gradient-animated text-white py-12 md:py-16 relative overflow-hidden">
    <!-- Decorative Elements -->
    <div class="absolute inset-0 bg-pattern-grid-light opacity-20"></div>
    <div class="absolute top-20 left-10 w-72 h-72 rounded-full bg-gold-500/10 blur-3xl"></div>
    <div class="absolute bottom-0 right-0 w-80 h-80 rounded-full bg-navy-500/30 blur-3xl translate-x-1/3 translate-y-1/3"></div>
    
    <div class="container-custom relative">
      <div class="grid lg:grid-cols-2 gap-12 items-start">
        <div>
          <div class="inline-flex items-center gap-2 px-4 py-1.5 bg-gold-500/20 text-gold-400 text-sm font-medium rounded-full mb-4 border border-gold-500/30">
            <MapPin class="w-4 h-4" />
            <span>{location.type === 'county' ? 'County' : 'City'}</span>
          </div>
          
          <h1 class="font-heading font-bold text-white mb-4">
            Personal Injury & Criminal Defense Lawyer in {location.name}
          </h1>
          
          <p class="text-xl text-gray-300 mb-6">
            {location.description}
          </p>
          
          {location.distanceFromOffice && (
            <p class="text-gray-400 mb-6 flex items-center gap-2">
              <span class="w-2 h-2 bg-gold-500 rounded-full"></span>
              <strong class="text-gold-400">{location.distanceFromOffice}</strong>
            </p>
          )}
          
          <div class="flex flex-wrap gap-3 mb-8">
            <div class="flex items-center gap-2 bg-white/5 backdrop-blur-sm px-3 py-1.5 rounded-full border border-white/10">
              <Check class="w-4 h-4 text-gold-500" />
              <span class="text-gray-200 text-sm">Free Consultation</span>
            </div>
            <div class="flex items-center gap-2 bg-white/5 backdrop-blur-sm px-3 py-1.5 rounded-full border border-white/10">
              <Check class="w-4 h-4 text-gold-500" />
              <span class="text-gray-200 text-sm">No Fee Unless We Win</span>
            </div>
          </div>
          
          <div class="flex flex-wrap gap-4">
            <a href="/contact-us/" class="btn btn-primary btn-glow shadow-elevated">
              Free Case Review
              <ArrowRight class="w-5 h-5" />
            </a>
            <a href="tel:+14104840400" class="btn btn-outline">
              <Phone class="w-5 h-5" />
              (410) 484-0400
            </a>
          </div>
        </div>
        
        <div class="relative">
          <div class="absolute -inset-2 bg-gold-500/20 rounded-3xl blur-xl"></div>
          <div class="relative bg-white rounded-2xl p-6 md:p-8 shadow-floating">
            <ContactForm 
              title={`Free Consultation for ${location.name} Residents`}
              subtitle="Tell us about your case and we'll get back to you within 24 hours."
              variant="default"
              showPhone={false}
            />
          </div>
        </div>
      </div>
    </div>
    
    <!-- Bottom Gradient Line -->
    <div class="absolute bottom-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-gold-500/50 to-transparent"></div>
  </section>
  
  <!-- Main Content -->
  <section class="section-padding relative">
    <div class="absolute inset-0 bg-pattern-dots opacity-20"></div>
    <div class="container-custom relative">
      <div class="grid lg:grid-cols-3 gap-12">
        <div class="lg:col-span-2 prose max-w-none">
          <slot />
          
          {location.courts && location.courts.length > 0 && (
            <div class="bg-gray-50 rounded-xl p-6 border border-gray-200 mt-8 not-prose">
              <h3 class="font-heading font-bold text-navy-900 mb-4 flex items-center gap-2">
                <Building class="w-5 h-5 text-gold-500" />
                Local Courts Serving {location.name}
              </h3>
              <ul class="grid md:grid-cols-2 gap-2">
                {location.courts.map(court => (
                  <li class="flex items-center gap-2 text-gray-700 text-sm">
                    <span class="w-1.5 h-1.5 bg-gold-500 rounded-full"></span>
                    {court}
                  </li>
                ))}
              </ul>
            </div>
          )}
          
          {location.hospitals && location.hospitals.length > 0 && (
            <div class="bg-gray-50 rounded-xl p-6 border border-gray-200 mt-6 not-prose">
              <h3 class="font-heading font-bold text-navy-900 mb-4 flex items-center gap-2">
                <span class="text-gold-500">+</span>
                Hospitals in {location.name}
              </h3>
              <ul class="grid md:grid-cols-2 gap-2">
                {location.hospitals.map(hospital => (
                  <li class="flex items-center gap-2 text-gray-700 text-sm">
                    <span class="w-1.5 h-1.5 bg-gold-500 rounded-full"></span>
                    {hospital}
                  </li>
                ))}
              </ul>
            </div>
          )}
        </div>
        
        <aside class="space-y-6">
          <!-- Attorney Card -->
          <AttorneySidebarCard />
          
          <!-- Office Info Card -->
          <div class="bg-white rounded-xl p-6 shadow-soft border border-gray-100">
            <h3 class="font-heading font-bold text-navy-900 mb-4">Contact Our Office</h3>
            <div class="space-y-4 text-sm">
              <div class="flex items-start gap-3">
                <div class="w-8 h-8 bg-navy-900 rounded-lg flex items-center justify-center flex-shrink-0">
                  <MapPin class="w-4 h-4 text-gold-500" />
                </div>
                <div>
                  <p class="text-gray-700 font-medium">25 Hooks Ln # 310</p>
                  <p class="text-gray-600">Pikesville, MD 21208</p>
                </div>
              </div>
              <div class="flex items-center gap-3">
                <div class="w-8 h-8 bg-navy-900 rounded-lg flex items-center justify-center flex-shrink-0">
                  <Phone class="w-4 h-4 text-gold-500" />
                </div>
                <a href="tel:+14104840400" class="text-gold-600 hover:text-gold-500 font-medium">(410) 484-0400</a>
              </div>
              <div class="flex items-center gap-3">
                <div class="w-8 h-8 bg-navy-900 rounded-lg flex items-center justify-center flex-shrink-0">
                  <Clock class="w-4 h-4 text-gold-500" />
                </div>
                <span class="text-gray-700">Available 24/7</span>
              </div>
            </div>
            <div class="mt-4 pt-4 border-t border-gray-100">
              <a href="/contact-us/" class="btn btn-primary w-full text-sm">
                Get Directions
              </a>
            </div>
          </div>
          
          <!-- Why Choose Us -->
          <div class="bg-gray-50 rounded-xl p-6 border border-gray-200">
            <h3 class="font-heading font-bold text-navy-900 mb-4">Why Choose Us</h3>
            <ul class="space-y-3">
              <li class="flex items-start gap-3">
                <div class="w-6 h-6 bg-gold-500/10 rounded-full flex items-center justify-center flex-shrink-0">
                  <Check class="w-4 h-4 text-gold-600" />
                </div>
                <span class="text-sm text-gray-700">26+ years of experience</span>
              </li>
              <li class="flex items-start gap-3">
                <div class="w-6 h-6 bg-gold-500/10 rounded-full flex items-center justify-center flex-shrink-0">
                  <Check class="w-4 h-4 text-gold-600" />
                </div>
                <span class="text-sm text-gray-700">Serving all of {location.name}</span>
              </li>
              <li class="flex items-start gap-3">
                <div class="w-6 h-6 bg-gold-500/10 rounded-full flex items-center justify-center flex-shrink-0">
                  <Check class="w-4 h-4 text-gold-600" />
                </div>
                <span class="text-sm text-gray-700">No fee unless we win</span>
              </li>
              <li class="flex items-start gap-3">
                <div class="w-6 h-6 bg-gold-500/10 rounded-full flex items-center justify-center flex-shrink-0">
                  <Check class="w-4 h-4 text-gold-600" />
                </div>
                <span class="text-sm text-gray-700">Multilingual staff</span>
              </li>
            </ul>
          </div>
        </aside>
      </div>
    </div>
  </section>
  
  <!-- Services -->
  <ServiceCards 
    services={featuredServices}
    title={`Legal Services in ${location.name}`}
    subtitle="How we can help"
    columns={3}
  />
  
  <CTASection 
    title={`Need Legal Help in ${location.name}?`}
    description="Contact us today for a free consultation. We serve clients throughout Maryland and are ready to fight for your rights."
    variant="centered"
  />
</PageLayout>
