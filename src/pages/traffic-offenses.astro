---
import PracticeAreaLayout from '../layouts/PracticeAreaLayout.astro';
import { criminalDefenseServices } from '../data/services';
import IconList from '../components/ui/IconList.astro';
import StatHighlight from '../components/ui/StatHighlight.astro';

const faqs = [
  {
    question: 'How does Maryland\'s point system work?',
    answer: 'Maryland assigns points to your driving record for traffic violations. Accumulating 8-11 points triggers a warning letter, while 12 or more points results in license suspension. Points remain on your record for 3 years. Serious violations like DUI carry 8 or 12 points and have additional consequences beyond the point system.'
  },
  {
    question: 'What is the penalty for reckless driving in Maryland?',
    answer: 'Reckless driving in Maryland is a misdemeanor carrying up to $1,000 in fines and 6 points on your license. Reckless endangerment—driving in a manner that creates substantial risk—can result in up to 5 years imprisonment. These charges often accompany other violations and should be taken seriously.'
  },
  {
    question: 'Should I just pay my traffic ticket or fight it?',
    answer: 'Paying a ticket is an admission of guilt that adds points to your record and can increase insurance rates. Many tickets can be contested successfully or negotiated to lesser offenses. A consultation with an attorney can help you understand whether fighting your ticket makes sense.'
  },
  {
    question: 'Can I go to jail for a traffic violation in Maryland?',
    answer: 'Most minor traffic violations are civil infractions without jail time. However, serious violations like reckless driving, driving on a suspended license, or fleeing police are criminal offenses that can result in jail time. Multiple violations or unpaid fines can also escalate to arrest.'
  },
  {
    question: 'How can I get points removed from my Maryland driving record?',
    answer: 'You can reduce points by completing a driver improvement course (removes 3 points, available once every 3 years). Some points may be removed if you successfully contest a ticket. After 3 years without violations, points expire. We can advise on the best strategy for your situation.'
  }
];

const relatedServices = criminalDefenseServices.filter(s => 
  ['dui', 'drug-crimes', 'assault'].includes(s.slug)
);

const breadcrumbs = [
  { label: 'Criminal Defense', href: '/criminal-defense/' },
  { label: 'Traffic Violations Defense' }
];

const pointSystemStats = [
  { value: '3–4', label: 'Points', description: 'Advisory letter from the MVA.' },
  { value: '5–7', label: 'Points', description: 'Warning letter requiring attention to driving habits.' },
  { value: '8–11', label: 'Points', description: 'Suspension risk; you may request a hearing.' },
  { value: '12+', label: 'Points', description: 'Automatic license revocation.' },
];

const commonPointValues = [
  'Speeding (1–9 mph over) – 1 point',
  'Speeding (10–19 mph over) – 2 points',
  'Speeding (20–29 mph over) – 2 points',
  'Speeding (30+ mph over) – 5 points',
  'Failure to stop at red light – 2 points',
  'Failure to stop at stop sign – 1 point',
  'Reckless driving – 6 points',
  'Aggressive driving – 5 points',
  'DUI/DWI – 8 or 12 points',
];

const pointConsequences = [
  '3–4 points – Advisory letter from MVA',
  '5–7 points – Warning letter requiring attention to driving habits',
  '8–11 points – License suspension possible; may request hearing',
  '12+ points – Automatic license revocation',
];

const criminalTrafficOffenses = [
  { text: 'Reckless driving', subtext: 'Misdemeanor, up to $1,000 fine, 6 points' },
  { text: 'Driving on suspended license', subtext: 'Up to 1 year jail, $1,000 fine' },
  { text: 'Hit and run (property damage)', subtext: 'Up to 60 days jail, $500 fine' },
  { text: 'Hit and run (injury)', subtext: 'Up to 5 years prison, felony' },
  { text: 'Racing on highways', subtext: 'Up to 1 year jail, $1,000 fine' },
  { text: 'Fleeing/eluding police', subtext: 'Up to 1 year jail, $1,000 fine' },
];

const defenseStrategies = [
  { text: 'Challenging the evidence', subtext: 'Radar/lidar accuracy, calibration records, and officer training' },
  { text: 'Procedural defenses', subtext: 'Errors in how the citation was issued or served' },
  { text: 'Witness credibility', subtext: 'Cross-examining the citing officer' },
  { text: 'Necessity defense', subtext: 'When circumstances required the conduct' },
  { text: 'Negotiating reduced charges', subtext: 'Minimize points and penalties where possible' },
  { text: 'Probation Before Judgment (PBJ)', subtext: 'Avoiding points on your record when eligible' },
];

const trueCosts = [
  { text: 'Insurance increases', subtext: 'Rates can rise 20–40% after a violation' },
  { text: 'Point accumulation', subtext: 'Leading to suspension or revocation' },
  { text: 'Employment impact', subtext: 'Especially for commercial drivers' },
  { text: 'Court costs and fees', subtext: 'In addition to fines' },
  { text: 'Time lost', subtext: 'Court appearances and MVA consequences' },
];

const reasonsToHire = [
  'Get charges reduced to non-point violations',
  'Obtain Probation Before Judgment to avoid points',
  'Have tickets dismissed entirely',
  'Negotiate lower fines',
  "Appear in court on your behalf so you don't miss work",
];
---

<PracticeAreaLayout
  title="Traffic Violations Defense Lawyer in Pikesville, MD"
  description="Experienced traffic defense attorneys in Maryland. We fight speeding tickets, reckless driving charges, and license suspensions. Protect your driving record today."
  heroTitle="Traffic Violations Defense in Maryland"
  heroDescription="Traffic violations can result in points on your license, increased insurance rates, and even jail time for serious offenses. Our attorneys fight to protect your driving record and keep you on the road."
  category="criminal-defense"
  faqs={faqs}
  relatedServices={relatedServices}
  breadcrumbs={breadcrumbs}
  heroImage="/images/stock/road-highway.jpg"
  accentColor="red"
>
  <h2>Experienced Traffic Violation Defense in Maryland</h2>
  <p>
    Many people don't realize how serious traffic violations can be in Maryland. What seems like a 
    simple ticket can add points to your license, dramatically increase your insurance rates, and 
    even threaten your ability to drive. At the Law Offices of Alex Poberesky, we help drivers 
    throughout Maryland fight traffic violations and protect their driving privileges.
  </p>
  <p>
    From minor speeding tickets to serious charges like reckless driving or driving on a suspended 
    license, our experienced attorneys know how to challenge traffic violations effectively and 
    minimize the impact on your record.
  </p>

  <h3>Traffic Violations We Defend</h3>
  <p>We handle all types of traffic violations, including:</p>
  <IconList
    items={[
      { text: 'Speeding tickets', subtext: 'Including excessive speed allegations' },
      { text: 'Reckless driving', subtext: 'Willful disregard for safety; can be criminal' },
      { text: 'Aggressive driving', subtext: 'Multiple violations committed as a single act' },
      { text: 'Running red lights / stop signs', subtext: 'Including camera-issued citations' },
      { text: 'Improper lane changes', subtext: 'Unsafe lane changes and failure to signal' },
      { text: 'Following too closely', subtext: 'Tailgating violations' },
      { text: 'Driving without a license', subtext: 'Operating without a valid license' },
      { text: 'Driving on suspended/revoked license', subtext: 'A criminal offense in Maryland' },
      { text: 'Hit and run', subtext: 'Leaving the scene of an accident' },
      { text: 'Racing on highways', subtext: 'Street racing allegations' },
    ]}
    columns={2}
    variant="card"
  />

  <h3>Maryland's Point System Explained</h3>
  <p>
    Maryland uses a point system to track driving violations. Points accumulate on your record and 
    can lead to license suspension:
  </p>
  <StatHighlight stats={pointSystemStats} variant="centered" columns={4} />
  
  <p><strong>Point Values for Common Violations:</strong></p>
  <IconList items={commonPointValues} columns={2} />

  <p><strong>Consequences of Point Accumulation:</strong></p>
  <IconList items={pointConsequences} columns={2} />

  <h3>Criminal Traffic Offenses</h3>
  <p>
    Some traffic violations are criminal offenses that can result in jail time, not just fines and points:
  </p>
  <IconList items={criminalTrafficOffenses} columns={2} variant="card" />

  <h3>Strategies for Fighting Traffic Violations</h3>
  <p>Our attorneys use various strategies to challenge traffic violations:</p>
  <IconList items={defenseStrategies} columns={2} variant="card" />

  <h3>The True Cost of Traffic Violations</h3>
  <p>Beyond the immediate fine, traffic violations can cost you significantly:</p>
  <IconList items={trueCosts} columns={2} variant="card" />

  <h3>Commercial Driver's License (CDL) Holders</h3>
  <p>
    If you hold a Commercial Driver's License, traffic violations have even more serious consequences. 
    CDL holders face stricter standards and can lose their livelihood over violations that might be 
    minor for regular drivers. We understand the unique challenges CDL holders face and work to protect 
    your commercial driving privileges.
  </p>

  <h3>Why Hire an Attorney for a Traffic Ticket?</h3>
  <p>
    Many people think traffic tickets aren't worth fighting, but an experienced attorney can often:
  </p>
  <IconList items={reasonsToHire} columns={2} />
  <p>
    Contact us for a free consultation to discuss whether fighting your traffic violation makes sense 
    for your situation.
  </p>
</PracticeAreaLayout>
