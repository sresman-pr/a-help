---
import PracticeAreaLayout from '../layouts/PracticeAreaLayout.astro';
import { personalInjuryServices } from '../data/services';
import StepCards from '../components/ui/StepCards.astro';
import IconList from '../components/ui/IconList.astro';

const faqs = [
  {
    question: 'What makes motorcycle accidents more dangerous?',
    answer: 'Motorcyclists lack the protective shell that cars provide. Even with helmets and protective gear, riders are directly exposed to impact forces, road surfaces, and other vehicles. Statistics show motorcyclists are 29 times more likely to die in a crash than car occupants.'
  },
  {
    question: 'What if I wasn\'t wearing a helmet?',
    answer: 'Maryland law requires helmets for all motorcycle riders. However, not wearing a helmet doesn\'t necessarily bar you from recovering compensation. We can still fight for your damages, though it may affect the amount you can recover for head injuries.'
  },
  {
    question: 'The other driver says they didn\'t see me. Is that a defense?',
    answer: 'No. Drivers have a duty to watch for all vehicles, including motorcycles. "I didn\'t see the motorcycle" is one of the most common excuses but it doesn\'t excuse negligent driving. We fight to hold drivers accountable for failing to see motorcyclists.'
  },
  {
    question: 'Can I still recover if I was lane splitting?',
    answer: 'Lane splitting (riding between lanes of traffic) is illegal in Maryland. However, even if you were lane splitting, you may still have a claim if the other driver was also negligent. Each case is different, so consult with an attorney.'
  }
];

const relatedServices = personalInjuryServices.filter(s => 
  ['car-accidents', 'bicycle-accidents', 'pedestrian-accidents'].includes(s.slug)
);

const breadcrumbs = [
  { label: 'Personal Injury', href: '/personal-injury/' },
  { label: 'Motorcycle Accidents' }
];

const postAccidentSteps = [
  { title: 'Get to Safety & Call 911', description: 'Move out of traffic if you can and request police and medical assistance.' },
  { title: 'Get Medical Care', description: 'Even if you feel okay, get evaluated—motorcycle injuries can show up later.' },
  { title: 'Document Everything', description: 'Take photos of the scene, your bike, vehicles, road hazards, and visible injuries.' },
  { title: 'Collect Witness Info', description: 'Get names and contact details from anyone who saw the crash.' },
  { title: 'Avoid Insurance Statements', description: 'Don’t give recorded statements or accept quick offers before legal advice.' },
  { title: 'Talk to a Lawyer', description: 'An attorney can preserve evidence and handle insurers while you focus on recovery.' },
];

const compensationItems = [
  'All medical expenses including future treatment',
  'Lost wages and diminished earning capacity',
  'Motorcycle repair or replacement',
  'Pain and suffering',
  'Scarring and disfigurement',
  'Loss of enjoyment of life',
  'Emotional distress',
];
---

<PracticeAreaLayout
  title="Motorcycle Accident Lawyer in Pikesville, MD"
  description="Experienced motorcycle accident attorneys in Maryland. We understand rider rights and fight for maximum compensation for injuries. Free consultation."
  heroTitle="Motorcycle Accident Lawyers in Maryland"
  heroDescription="Motorcyclists deserve the same respect and protection as any other driver. When negligent drivers cause accidents, we fight aggressively for riders' rights to full compensation."
  category="personal-injury"
  faqs={faqs}
  relatedServices={relatedServices}
  breadcrumbs={breadcrumbs}
  heroImage="/images/stock/road-highway.jpg"
  accentColor="gold"
>
  <h2>Dedicated Motorcycle Accident Attorneys</h2>
  <p>
    Motorcycle accidents often result in severe injuries due to the rider's exposure and vulnerability. 
    At the Law Offices of Alex Poberesky, we understand the unique challenges motorcyclists face—both 
    on the road and in the legal system.
  </p>
  <p>
    Many people, including insurance adjusters, hold unfair biases against motorcyclists. We fight 
    these biases and ensure our clients receive the compensation they deserve, regardless of 
    preconceived notions about motorcycle riders.
  </p>

  <h3>What to Do After a Motorcycle Accident</h3>
  <p>
    The steps you take right after a crash can make a major difference in both your health and your claim.
  </p>
  <StepCards steps={postAccidentSteps} columns={3} variant="numbered" />

  <h3>Common Causes of Motorcycle Accidents</h3>
  <IconList 
    items={[
      { text: 'Left-turn accidents', subtext: 'Drivers failing to see motorcycles when turning' },
      { text: 'Failure to yield', subtext: 'Drivers not giving motorcyclists right of way' },
      { text: 'Distracted driving', subtext: 'Drivers on phones missing motorcycles in traffic' },
      { text: 'Speeding', subtext: 'Both by motorcyclists and other drivers' },
      { text: 'Lane changes', subtext: 'Drivers failing to check blind spots' },
      { text: 'Road hazards', subtext: 'Potholes, debris, oil slicks particularly dangerous for bikes' },
      { text: 'Door opening accidents', subtext: 'Parked car occupants opening doors into traffic' },
      { text: 'DUI/Impaired driving', subtext: 'Intoxicated drivers failing to see motorcycles' },
    ]}
    columns={2}
    variant="card"
  />

  <h3>Common Motorcycle Accident Injuries</h3>
  <p>Due to the lack of protection, motorcycle accidents often cause serious injuries:</p>
  <IconList 
    items={[
      { text: 'Road rash', subtext: 'Severe skin abrasions requiring skin grafts' },
      { text: 'Traumatic brain injuries', subtext: 'Even with helmets, TBIs are common' },
      { text: 'Spinal cord injuries', subtext: 'Potentially causing paralysis' },
      { text: 'Broken bones', subtext: 'Legs, arms, pelvis, ribs' },
      { text: 'Internal injuries', subtext: 'Organ damage and internal bleeding' },
      { text: 'Biker\'s arm', subtext: 'Nerve damage from impact to the arm' },
      { text: 'Facial and dental injuries', subtext: 'From impact with road or objects' },
    ]}
    columns={2}
    variant="card"
  />

  <h3>Compensation for Motorcycle Accidents</h3>
  <p>You may be entitled to recover:</p>
  <IconList items={compensationItems} columns={2} />

  <h3>Why Choose a Motorcycle Accident Specialist</h3>
  <p>
    Motorcycle accident cases require an attorney who understands the physics of motorcycle crashes, 
    the biases that motorcyclists face, and the serious nature of typical motorcycle injuries. We 
    have the experience and resources to build compelling cases that overcome anti-motorcycle bias 
    and secure maximum compensation for our clients.
  </p>
</PracticeAreaLayout>
