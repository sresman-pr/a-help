---
import PageLayout from '../layouts/PageLayout.astro';
import Breadcrumbs from '../components/common/Breadcrumbs.astro';
import CTASection from '../components/sections/CTASection.astro';
import { Star, Quote } from '@lucide/astro';
import { testimonials } from '../data/testimonials';

const breadcrumbs = [
  { label: 'Client Reviews' }
];

// Review Schema for SEO
const reviewSchema = {
  "@context": "https://schema.org",
  "@type": "LegalService",
  "name": "Law Offices of Alex Poberesky, P.A.",
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "5",
    "reviewCount": testimonials.length.toString(),
    "bestRating": "5",
    "worstRating": "1"
  },
  "review": testimonials.map(t => ({
    "@type": "Review",
    "author": {
      "@type": "Person",
      "name": t.name
    },
    "reviewRating": {
      "@type": "Rating",
      "ratingValue": t.rating.toString(),
      "bestRating": "5"
    },
    "reviewBody": t.text
  }))
};
---

<PageLayout 
  title="Client Reviews | Maryland Personal Injury & Criminal Defense Lawyer"
  description="Read what our clients say about working with the Law Offices of Alex Poberesky. 5-star rated personal injury and criminal defense attorneys in Maryland."
>
  <Breadcrumbs items={breadcrumbs} />
  
  <section class="section-padding">
    <div class="container-custom">
      <div class="text-center max-w-3xl mx-auto mb-12">
        <h1 class="font-heading font-bold text-navy-900 mb-4">Client Reviews</h1>
        <p class="text-xl text-gray-600 mb-6">
          Don't just take our word for it. Read what our clients have to say about their experience 
          working with the Law Offices of Alex Poberesky.
        </p>
        
        <!-- Aggregate Rating -->
        <div class="inline-flex items-center gap-3 bg-gold-50 px-6 py-3 rounded-full">
          <div class="flex">
            {[...Array(5)].map(() => (
              <Star class="w-6 h-6 text-gold-500 fill-gold-500" />
            ))}
          </div>
          <span class="font-bold text-navy-900 text-lg">5.0</span>
          <span class="text-gray-600">based on {testimonials.length} reviews</span>
        </div>
      </div>
      
      <!-- Reviews Grid -->
      <div class="grid md:grid-cols-2 gap-8">
        {testimonials.map((testimonial) => (
          <div class="bg-white rounded-xl p-8 shadow-sm border border-gray-100">
            <Quote class="w-12 h-12 text-gold-500/20 mb-4" />
            
            <!-- Rating -->
            <div class="flex gap-1 mb-4">
              {[...Array(testimonial.rating)].map(() => (
                <Star class="w-5 h-5 text-gold-500 fill-gold-500" />
              ))}
            </div>
            
            <!-- Review Text -->
            <p class="text-gray-700 leading-relaxed mb-6">
              "{testimonial.text}"
            </p>
            
            <!-- Author -->
            <div class="flex items-center gap-4 pt-4 border-t border-gray-100">
              <div class="w-12 h-12 bg-navy-900 rounded-full flex items-center justify-center">
                <span class="text-gold-500 font-bold text-lg">
                  {testimonial.name.charAt(0)}
                </span>
              </div>
              <div>
                <div class="font-semibold text-navy-900">{testimonial.name}</div>
                <div class="text-sm text-gray-500">{testimonial.location}</div>
              </div>
              {testimonial.caseType && (
                <span class="ml-auto px-3 py-1 bg-gold-50 text-gold-700 text-xs font-medium rounded-full">
                  {testimonial.caseType}
                </span>
              )}
            </div>
          </div>
        ))}
      </div>
      
      <!-- Review Platforms -->
      <div class="mt-16 text-center">
        <h2 class="font-heading font-bold text-navy-900 mb-6">Find Us On</h2>
        <p class="text-gray-600 mb-8">
          We're proud of our reputation. Check out our reviews on these platforms:
        </p>
        <div class="flex flex-wrap justify-center gap-8">
          <a href="#" class="text-gray-400 hover:text-navy-900 transition-colors">
            <div class="text-center">
              <div class="text-2xl font-bold">Google</div>
              <div class="flex justify-center mt-1">
                {[...Array(5)].map(() => (
                  <Star class="w-4 h-4 text-gold-500 fill-gold-500" />
                ))}
              </div>
            </div>
          </a>
          <a href="#" class="text-gray-400 hover:text-navy-900 transition-colors">
            <div class="text-center">
              <div class="text-2xl font-bold">Avvo</div>
              <div class="flex justify-center mt-1">
                {[...Array(5)].map(() => (
                  <Star class="w-4 h-4 text-gold-500 fill-gold-500" />
                ))}
              </div>
            </div>
          </a>
          <a href="#" class="text-gray-400 hover:text-navy-900 transition-colors">
            <div class="text-center">
              <div class="text-2xl font-bold">Yelp</div>
              <div class="flex justify-center mt-1">
                {[...Array(5)].map(() => (
                  <Star class="w-4 h-4 text-gold-500 fill-gold-500" />
                ))}
              </div>
            </div>
          </a>
        </div>
      </div>
    </div>
  </section>
  
  <CTASection 
    title="Ready to Experience Our Commitment to Excellence?"
    description="Join the hundreds of satisfied clients who have trusted us with their legal matters. Contact us today for a free consultation."
    variant="centered"
  />
  
  <script type="application/ld+json" set:html={JSON.stringify(reviewSchema)} />
</PageLayout>
