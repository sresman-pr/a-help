---
import PracticeAreaLayout from '../layouts/PracticeAreaLayout.astro';
import { personalInjuryServices } from '../data/services';
import IconList from '../components/ui/IconList.astro';
import StatHighlight from '../components/ui/StatHighlight.astro';

const faqs = [
  {
    question: 'Who can file a wrongful death claim in Maryland?',
    answer: 'In Maryland, wrongful death claims can be filed by the spouse, children, or parents of the deceased. If there are no primary beneficiaries, secondary beneficiaries (siblings, other relatives) may have rights. A survival action can be brought by the personal representative of the estate.'
  },
  {
    question: 'What\'s the difference between a wrongful death claim and a survival action?',
    answer: 'A wrongful death claim compensates surviving family members for their losses (loss of companionship, financial support). A survival action recovers damages the deceased could have claimed if they survived (medical expenses, pain and suffering before death). Both may be pursued.'
  },
  {
    question: 'How long do I have to file a wrongful death claim?',
    answer: 'Maryland has a three-year statute of limitations for wrongful death claims, starting from the date of death. Given the complexity of these cases and the grieving process, it\'s important to consult an attorney promptly.'
  },
  {
    question: 'What damages can be recovered in a wrongful death case?',
    answer: 'Recoverable damages include funeral and burial expenses, lost income and benefits the deceased would have provided, loss of companionship and guidance, mental anguish of surviving family members, and medical expenses before death.'
  }
];

const relatedServices = personalInjuryServices.filter(s => 
  ['car-accidents', 'medical-malpractice', 'truck-accidents'].includes(s.slug)
);

const breadcrumbs = [
  { label: 'Personal Injury', href: '/personal-injury/' },
  { label: 'Wrongful Death' }
];

const whoCanSue = [
  { text: 'Spouse, children, or parents', subtext: 'Primary beneficiaries under Maryland wrongful death law' },
  { text: 'Other relatives', subtext: 'Potential secondary beneficiaries when no primary beneficiaries exist' },
  { text: 'The estate (survival action)', subtext: 'Brought by the personal representative for damages the deceased could have claimed' },
];

const compensationTypes = [
  { value: 'Economic', label: 'Losses', description: 'Funeral/burial costs, medical bills, lost income and benefits.' },
  { value: 'Non‑Economic', label: 'Losses', description: 'Loss of companionship, guidance, and mental anguish.' },
  { value: 'Estate', label: 'Damages', description: 'Pain and suffering before death and other survival action damages.' },
];

const commonWrongfulDeathCauses = [
  { text: 'Car and truck accidents', subtext: 'Fatal crashes caused by negligent drivers' },
  { text: 'Medical malpractice', subtext: 'Fatal surgical errors, misdiagnosis, medication errors' },
  { text: 'Workplace accidents', subtext: 'Construction fatalities, industrial accidents' },
  { text: 'Defective products', subtext: 'Fatal product malfunctions or failures' },
  { text: 'Premises liability', subtext: 'Fatal falls, inadequate security' },
  { text: 'Nursing home abuse/neglect', subtext: 'Deaths from neglect or abuse' },
  { text: 'Criminal acts', subtext: 'Assault, DUI, and other violent acts' },
];

const wrongfulDeathDamages = [
  'Funeral and burial expenses',
  'Medical expenses before death',
  'Lost income and financial support the deceased would have provided',
  'Lost benefits (health insurance, pension, etc.)',
  'Loss of companionship and consortium',
  'Loss of parental guidance and nurturing for children',
  'Mental anguish and emotional pain of surviving family members',
];
---

<PracticeAreaLayout
  title="Wrongful Death Lawyer in Pikesville, MD"
  description="Compassionate wrongful death attorneys in Maryland. We help families seek justice and compensation after losing a loved one to negligence. Free consultation."
  heroTitle="Wrongful Death Lawyers in Maryland"
  heroDescription="Losing a loved one due to someone else's negligence is devastating. We provide compassionate representation while fighting aggressively for the justice your family deserves."
  category="personal-injury"
  faqs={faqs}
  relatedServices={relatedServices}
  breadcrumbs={breadcrumbs}
  heroImage="/images/stock/hero-courthouse.jpg"
  accentColor="gold"
>
  <h2>Compassionate Legal Representation for Grieving Families</h2>
  <p>
    The death of a loved one is always painful, but when that death is caused by someone else's 
    negligence or wrongdoing, the grief is compounded by anger and a sense of injustice. At the 
    Law Offices of Alex Poberesky, we understand what your family is going through.
  </p>
  <p>
    We provide compassionate support while fighting aggressively to hold responsible parties 
    accountable. While no amount of money can bring back your loved one, a wrongful death claim 
    can help provide financial security and a sense of justice.
  </p>

  <h3>Causes of Wrongful Death</h3>
  <p>Wrongful death claims may arise from:</p>
  <IconList items={commonWrongfulDeathCauses} columns={2} variant="card" />

  <h3>Who Can File a Wrongful Death Claim?</h3>
  <p>Under Maryland law, the following may file a wrongful death claim:</p>
  <IconList items={whoCanSue} columns={2} variant="card" />

  <h3>Damages Available</h3>
  <p>Wrongful death claims may recover:</p>
  <StatHighlight stats={compensationTypes} variant="centered" columns={3} />
  <IconList items={wrongfulDeathDamages} columns={2} />

  <h3>Our Approach to Wrongful Death Cases</h3>
  <p>
    We handle wrongful death cases with the sensitivity and care they require. We work to minimize 
    the burden on your family during this difficult time while conducting thorough investigations 
    to establish liability and build the strongest possible case.
  </p>
  <p>
    If you've lost a loved one due to someone else's negligence, we encourage you to contact us 
    for a free, confidential consultation. There's no pressure and no obligation—just answers to 
    your questions and guidance on your options.
  </p>
</PracticeAreaLayout>
