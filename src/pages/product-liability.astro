---
import PracticeAreaLayout from '../layouts/PracticeAreaLayout.astro';
import { personalInjuryServices } from '../data/services';
import IconList from '../components/ui/IconList.astro';
import CalloutBox from '../components/ui/CalloutBox.astro';

const faqs = [
  {
    question: 'What is product liability?',
    answer: 'Product liability refers to the legal responsibility of manufacturers, distributors, and retailers for injuries caused by defective products. If a product is unreasonably dangerous due to design defects, manufacturing defects, or inadequate warnings, the companies in the supply chain can be held liable for resulting injuries.'
  },
  {
    question: 'What types of defects can lead to a product liability claim?',
    answer: 'There are three main types: design defects (the product\'s design is inherently dangerous), manufacturing defects (errors during production make a specific product dangerous), and marketing defects (failure to provide adequate warnings or instructions about risks).'
  },
  {
    question: 'Do I have to prove the manufacturer was negligent?',
    answer: 'Not necessarily. Maryland recognizes strict liability for product defect cases, meaning you may only need to prove the product was defective and caused your injury—not that the manufacturer was careless. However, negligence claims are also available and sometimes beneficial.'
  },
  {
    question: 'What should I do if I\'m injured by a defective product?',
    answer: 'Preserve the product exactly as it is—don\'t repair, modify, or discard it. Keep all packaging, receipts, and documentation. Photograph everything. Seek medical attention and document your injuries. Then contact a product liability attorney to evaluate your case.'
  },
  {
    question: 'How long do I have to file a product liability lawsuit in Maryland?',
    answer: 'Maryland has a three-year statute of limitations for product liability claims from the date of injury. There\'s also a statute of repose that can limit claims for older products. Contact an attorney promptly to ensure you don\'t miss important deadlines.'
  }
];

const relatedServices = personalInjuryServices.filter(s => 
  ['medical-malpractice', 'workplace-accidents', 'wrongful-death'].includes(s.slug)
);

const breadcrumbs = [
  { label: 'Personal Injury', href: '/personal-injury/' },
  { label: 'Product Liability' }
];

const designDefectExamples = [
  'Vehicles prone to rollover due to high center of gravity',
  "Children's toys with small parts that pose choking hazards",
  'Furniture that tips over easily',
  'Electronic devices that overheat and catch fire',
];

const manufacturingDefectExamples = [
  'Contaminated food or medications',
  'Improperly installed vehicle components',
  'Faulty welds or materials in appliances',
  'Missing safety components',
];

const failureToWarnExamples = [
  'Medications without proper warning labels about side effects',
  'Power tools lacking safety instructions',
  'Products without warnings about foreseeable misuse risks',
  "Missing age-appropriate warnings for children's products",
];

const commonInjuryProducts = [
  { text: 'Vehicles and auto parts', subtext: 'Defective airbags, tires, brakes, seatbelts' },
  { text: 'Medications and medical devices', subtext: 'Dangerous drugs, faulty implants, defective surgical instruments' },
  { text: 'Household appliances', subtext: 'Fires, electrocution, explosions' },
  { text: "Children's products", subtext: 'Toys, cribs, car seats, strollers' },
  { text: 'Power tools and machinery', subtext: 'Inadequate guards, unexpected activation' },
  { text: 'Electronics', subtext: 'Battery fires, electrocution, burns' },
  { text: 'Food products', subtext: 'Contamination, foreign objects, allergen labeling failures' },
  { text: 'Recreational equipment', subtext: 'Bikes, ATVs, exercise equipment' },
];

const distributionChainParties = [
  'Product manufacturers',
  'Component part manufacturers',
  'Wholesalers and distributors',
  'Retail stores',
  'Importers',
];

const productLiabilityCompensation = [
  'Medical expenses (current and future)',
  'Lost wages and diminished earning capacity',
  'Pain and suffering',
  'Permanent disability or disfigurement',
  'Property damage',
  'Emotional distress',
  'Loss of enjoyment of life',
  'Wrongful death damages for families who lost loved ones',
  'Punitive damages when manufacturers knowingly sold dangerous products (when available)',
];

const whyTheseCasesAreComplex = [
  'Expert witnesses in engineering, medicine, and manufacturing',
  'Extensive investigation and evidence preservation',
  'Complex scientific and technical evidence',
  'Large corporations with aggressive legal teams',
  'Multi-state or federal litigation',
];
---

<PracticeAreaLayout
  title="Product Liability Lawyer in Pikesville, MD"
  description="Experienced product liability attorneys in Maryland. We hold manufacturers accountable for injuries caused by defective products. Free consultation."
  heroTitle="Product Liability Lawyers in Maryland"
  heroDescription="When defective products cause injuries, manufacturers must be held accountable. We fight against large corporations to secure justice and compensation for victims of dangerous products."
  category="personal-injury"
  faqs={faqs}
  relatedServices={relatedServices}
  breadcrumbs={breadcrumbs}
  heroImage="/images/stock/hero-courthouse.jpg"
  accentColor="gold"
>
  <h2>Experienced Product Liability Attorneys in Maryland</h2>
  <p>
    Every day, we trust that the products we use are safe. When manufacturers, distributors, and 
    retailers put dangerous products into consumers' hands, the results can be devastating—serious 
    injuries, permanent disabilities, and even death. At the Law Offices of Alex Poberesky, we 
    hold these companies accountable.
  </p>
  <p>
    With over 26 years of experience, we have the resources and determination to take on large 
    corporations and their teams of lawyers. We fight aggressively to secure fair compensation 
    for victims of defective products.
  </p>

  <CalloutBox title="Strict Liability in Many Defect Cases" variant="info">
    <p class="mb-0">
      In many product defect claims, you may not need to prove a company was “careless.” Instead, the focus is often on
      whether the product was <strong>defective and unreasonably dangerous</strong> and whether that defect caused your injuries.
      We evaluate all available theories—strict liability, negligence, and failure to warn—to maximize your case.
    </p>
  </CalloutBox>

  <h3>Types of Product Defects</h3>
  <p>Product liability claims generally fall into three categories:</p>

  <IconList
    items={[
      { text: 'Design defects', subtext: 'The product is unsafe as designed, even when manufactured correctly.' },
      { text: 'Manufacturing defects', subtext: 'A mistake in production makes a particular unit dangerous.' },
      { text: 'Failure to warn', subtext: 'Inadequate instructions or warnings about known or foreseeable risks.' },
    ]}
    columns={2}
    variant="card"
  />
  
  <h4>Design Defects</h4>
  <p>
    A design defect exists when the product's basic design is inherently dangerous, regardless 
    of how carefully it's manufactured. Examples include:
  </p>
  <IconList items={designDefectExamples} columns={2} />

  <h4>Manufacturing Defects</h4>
  <p>
    Manufacturing defects occur when errors during production make a specific product dangerous, 
    even though the design is safe. Examples include:
  </p>
  <IconList items={manufacturingDefectExamples} columns={2} />

  <h4>Marketing Defects (Failure to Warn)</h4>
  <p>
    Even a well-designed, properly manufactured product can be dangerous if it lacks adequate 
    warnings or instructions. Examples include:
  </p>
  <IconList items={failureToWarnExamples} columns={2} />

  <h3>Products That Commonly Cause Injuries</h3>
  <IconList items={commonInjuryProducts} columns={2} variant="card" />

  <h3>Who Can Be Held Liable?</h3>
  <p>
    Product liability claims can be brought against any party in the distribution chain, 
    including:
  </p>
  <IconList items={distributionChainParties} columns={2} />

  <h3>Compensation in Product Liability Cases</h3>
  <p>Victims of defective products may recover:</p>
  <IconList items={productLiabilityCompensation} columns={2} />

  <h3>Why Product Liability Cases Require Experienced Attorneys</h3>
  <p>
    Product liability cases are among the most complex personal injury claims. They often involve:
  </p>
  <IconList items={whyTheseCasesAreComplex} columns={2} />
  <p>
    We have the experience and resources to handle these challenging cases. If you've been 
    injured by a defective product, contact us for a free consultation. We work on a contingency 
    fee basis—you pay nothing unless we win your case.
  </p>
</PracticeAreaLayout>
