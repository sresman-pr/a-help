---
import PracticeAreaLayout from '../layouts/PracticeAreaLayout.astro';
import { criminalDefenseServices } from '../data/services';
import IconList from '../components/ui/IconList.astro';
import CalloutBox from '../components/ui/CalloutBox.astro';

const faqs = [
  {
    question: 'What are the penalties for marijuana possession in Maryland?',
    answer: 'Maryland has decriminalized possession of small amounts of marijuana (under 10 grams) for personal use, making it a civil offense with a fine up to $100. However, possession of larger amounts, possession with intent to distribute, or distribution remains a criminal offense with serious penalties including jail time.'
  },
  {
    question: 'What is the difference between possession and distribution charges?',
    answer: 'Simple possession is having drugs for personal use. Distribution charges apply when you\'re accused of selling, delivering, or intending to sell drugs. Distribution carries much harsher penalties. Prosecutors may charge distribution based on the quantity found, packaging, scales, large amounts of cash, or other evidence suggesting intent to sell.'
  },
  {
    question: 'Can I get probation instead of jail for a drug charge?',
    answer: 'Many first-time offenders and some repeat offenders may be eligible for probation, drug court, or diversion programs that focus on treatment rather than incarceration. We work to identify all available alternatives to jail and advocate for the best possible outcome in your case.'
  },
  {
    question: 'Will a drug conviction affect my professional license?',
    answer: 'Yes, drug convictions can impact professional licenses for nurses, doctors, lawyers, teachers, and many other professions. Some licenses may be suspended or revoked. We understand these stakes and fight to minimize the professional consequences of drug charges.'
  },
  {
    question: 'Can drug charges be expunged from my record in Maryland?',
    answer: 'Some drug charges may be eligible for expungement, particularly if charges were dismissed or you were found not guilty. Certain convictions may also be expunged after a waiting period. We can advise you on expungement eligibility and help clear your record when possible.'
  }
];

const relatedServices = criminalDefenseServices.filter(s => 
  ['dui', 'assault', 'theft-offenses'].includes(s.slug)
);

const breadcrumbs = [
  { label: 'Criminal Defense', href: '/criminal-defense/' },
  { label: 'Drug Crimes Defense' }
];

const marijuanaPenalties = [
  'Under 10 grams (personal use) – Civil fine up to $100',
  '10–50 grams – Misdemeanor, up to 1 year jail, $1,000 fine',
  'Over 50 grams – Felony, up to 5 years, $15,000 fine',
  'Distribution – Up to 5 years, $15,000 fine (more for subsequent offenses)',
];

const scheduleIiiPenalties = [
  'Possession – Up to 4 years, $25,000 fine',
  'Distribution – Up to 20 years, $25,000 fine',
  'Distribution near schools – Enhanced penalties may apply',
  'Large quantities (trafficking) – 25+ years possible in extreme cases',
];

const prescriptionDrugPenalties = [
  'Possession (without valid prescription) – Up to 4 years, $25,000 fine',
  'Distribution – Up to 20 years, $25,000 fine',
  'Prescription fraud – Additional charges possible',
];

const drugChargeDefenses = [
  { text: 'Illegal search and seizure', subtext: 'If police violated your Fourth Amendment rights, evidence may be suppressed.' },
  { text: 'Lack of knowledge', subtext: "You didn’t know drugs were present or what they were." },
  { text: 'Lack of possession', subtext: 'The drugs were not yours or not in your control.' },
  { text: 'Entrapment', subtext: "Police induced a crime you wouldn’t otherwise commit." },
  { text: 'Lab testing errors', subtext: 'Challenging drug identification and methodology.' },
  { text: 'Chain of custody issues', subtext: 'Evidence was not properly handled or documented.' },
  { text: 'Valid prescription', subtext: 'You had a legitimate prescription for the medication.' },
];

const alternativeSentencing = [
  { text: 'Drug Court', subtext: 'Treatment-focused program with intensive supervision instead of incarceration.' },
  { text: 'Probation Before Judgment (PBJ)', subtext: 'Successful completion can avoid a conviction on your record.' },
  { text: 'Diversion programs', subtext: 'Complete treatment/requirements and have charges dismissed (when eligible).' },
  { text: 'Suspended sentences', subtext: 'Jail time suspended in favor of probation and conditions.' },
];

const collateralConsequences = [
  'Employment opportunities and professional licenses',
  'Federal student financial aid eligibility',
  'Housing applications (especially public housing)',
  'Child custody proceedings',
  'Immigration status for non-citizens',
  'Firearm ownership rights',
];
---

<PracticeAreaLayout
  title="Drug Crimes Defense Lawyer in Pikesville, MD"
  description="Experienced drug crime defense attorneys in Maryland. We defend possession, distribution, and trafficking charges. Protect your future with a free consultation."
  heroTitle="Drug Crimes Defense Lawyers in Maryland"
  heroDescription="Drug charges can devastate your future, affecting your freedom, career, and reputation. Our experienced defense attorneys fight aggressively to protect your rights and explore every possible defense."
  category="criminal-defense"
  faqs={faqs}
  relatedServices={relatedServices}
  breadcrumbs={breadcrumbs}
  heroImage="/images/stock/courtroom-empty.jpg"
  accentColor="red"
>
  <h2>Experienced Drug Crime Defense in Maryland</h2>
  <p>
    Drug charges in Maryland range from minor possession offenses to serious felonies that carry years 
    in prison. At the Law Offices of Alex Poberesky, we provide aggressive defense for all types of 
    drug charges, working tirelessly to protect your freedom, your record, and your future.
  </p>
  <p>
    Our criminal defense attorneys have extensive experience defending clients against drug charges 
    throughout Maryland. We understand the complexities of drug laws, the science behind drug testing, 
    and the constitutional issues that can arise in these cases.
  </p>

  <h3>Types of Drug Charges We Defend</h3>
  <p>We handle all types of drug-related criminal charges, including:</p>
  <IconList
    items={[
      { text: 'Simple possession', subtext: 'Having drugs for personal use' },
      { text: 'Possession with intent to distribute', subtext: 'Quantity/packaging allegations used to claim intent to sell' },
      { text: 'Distribution / dealing', subtext: 'Selling, delivering, or sharing controlled substances' },
      { text: 'Trafficking', subtext: 'Large-scale distribution allegations with major sentencing exposure' },
      { text: 'Manufacturing', subtext: 'Producing or processing illegal substances' },
      { text: 'Prescription fraud', subtext: 'Obtaining prescription medications unlawfully' },
      { text: 'Drug paraphernalia', subtext: 'Possession of items prosecutors claim are used for drug use' },
    ]}
    columns={2}
    variant="card"
  />

  <h3>Maryland Drug Penalties by Substance Type</h3>
  <CalloutBox title="Penalties Often Track Drug Schedule" variant="warning">
    <p class="mb-0">
      Maryland penalties vary based on the substance involved (including its schedule), the amount, and whether the state
      alleges distribution. For example, many Schedule I/II allegations can expose you to <strong>years of incarceration</strong>,
      while some low-level marijuana possession is treated as a civil offense. We evaluate the exact charge, schedule, and
      enhancement allegations to target the best defense.
    </p>
  </CalloutBox>
  
  <p><strong>Marijuana:</strong></p>
  <IconList items={marijuanaPenalties} columns={2} />

  <p><strong>Cocaine, Heroin, and Other Schedule I/II Drugs:</strong></p>
  <IconList items={scheduleIiiPenalties} columns={2} />

  <p><strong>Prescription Drugs (without valid prescription):</strong></p>
  <IconList items={prescriptionDrugPenalties} columns={2} />

  <h3>Drug-Free Zone Enhancements</h3>
  <p>
    Maryland law imposes enhanced penalties for drug offenses committed within 1,000 feet of schools, 
    parks, playgrounds, and other designated areas. These enhancements can significantly increase the 
    potential penalties you face. Our attorneys investigate whether these enhancements apply and 
    challenge them when appropriate.
  </p>

  <h3>Defenses to Drug Charges</h3>
  <p>We explore every possible defense strategy, including:</p>
  <IconList items={drugChargeDefenses} columns={2} variant="card" />

  <h3>Alternative Sentencing Options</h3>
  <p>
    Maryland offers several alternatives to incarceration for drug offenders, particularly first-time 
    offenders and those struggling with addiction:
  </p>
  <IconList items={alternativeSentencing} columns={2} variant="card" />
  <p>
    We work to identify which alternatives may be available in your case and advocate for treatment-focused 
    solutions whenever appropriate.
  </p>

  <h3>Collateral Consequences of Drug Convictions</h3>
  <p>Beyond the immediate criminal penalties, drug convictions can affect:</p>
  <IconList items={collateralConsequences} columns={2} />
  <p>
    We understand these far-reaching consequences and fight to minimize the impact on every aspect 
    of your life.
  </p>

  <h3>Why Choose Our Drug Crime Defense Team</h3>
  <p>
    With over 26 years of criminal defense experience in Maryland, we know how to effectively challenge 
    drug charges and protect our clients' rights. We've successfully defended clients facing everything 
    from simple possession to serious trafficking charges. Contact us for a free, confidential consultation 
    to discuss your case.
  </p>
</PracticeAreaLayout>
