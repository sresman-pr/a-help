---
import PracticeAreaLayout from '../layouts/PracticeAreaLayout.astro';
import { criminalDefenseServices } from '../data/services';
import StatHighlight from '../components/ui/StatHighlight.astro';
import StepCards from '../components/ui/StepCards.astro';
import CalloutBox from '../components/ui/CalloutBox.astro';
import IconList from '../components/ui/IconList.astro';

const faqs = [
  {
    question: 'What are the penalties for a first-time DUI in Maryland?',
    answer: 'A first DUI offense in Maryland can result in up to 1 year in jail, fines up to $1,000, 8 points on your license, and a 6-month license suspension. A DWI (lower BAC) carries up to 60 days in jail and $500 in fines. An experienced attorney can often negotiate reduced charges or alternative sentencing.'
  },
  {
    question: 'Will I lose my license after a DUI arrest in Maryland?',
    answer: 'Your license can be suspended administratively by the MVA and as part of criminal penalties. You only have 30 days from your arrest to request an MVA hearing to challenge the suspension. We can represent you at both the MVA hearing and in criminal court to protect your driving privileges.'
  },
  {
    question: 'What is the ignition interlock program in Maryland?',
    answer: 'Maryland\'s Ignition Interlock Program requires installation of a breathalyzer device in your vehicle that prevents it from starting if alcohol is detected. This may be required for license reinstatement after a DUI conviction. Participation can sometimes allow you to continue driving during your suspension period.'
  },
  {
    question: 'Can I refuse a breathalyzer test in Maryland?',
    answer: 'Under Maryland\'s implied consent law, refusing a breathalyzer test results in automatic license suspension—120 days for a first refusal, 1 year for subsequent refusals. However, the refusal cannot be used as direct evidence of guilt in court. The decision to refuse has significant consequences either way.'
  },
  {
    question: 'What defenses are available for DUI charges in Maryland?',
    answer: 'Common defenses include challenging the legality of the traffic stop, questioning the accuracy of breathalyzer or field sobriety tests, examining whether proper procedures were followed, and challenging the officer\'s observations. Every case is different, and we thoroughly investigate all possible defenses.'
  }
];

const relatedServices = criminalDefenseServices.filter(s => 
  ['drug-crimes', 'traffic-offenses', 'assault'].includes(s.slug)
);

const breadcrumbs = [
  { label: 'Criminal Defense', href: '/criminal-defense/' },
  { label: 'DUI/DWI Defense' }
];

const firstOffensePenaltyStats = [
  { value: '1 year', label: 'Max Jail (DUI)', description: 'First offense DUI can carry up to 1 year in jail.' },
  { value: '$1,000', label: 'Max Fine (DUI)', description: 'Fines can reach $1,000 for a first DUI.' },
  { value: '8', label: 'License Points', description: 'A DUI conviction adds 8 points to your driving record.' },
];

const duiVsDwi = [
  { text: 'DUI (Driving Under the Influence)', subtext: 'BAC of 0.08%+ or substantially impaired by alcohol or drugs' },
  { text: 'DWI (Driving While Impaired)', subtext: 'BAC between 0.04% and 0.07% or impaired to some extent by alcohol' },
];

const firstDuiPenalties = [
  'Up to 1 year in jail',
  'Fines up to $1,000',
  '8 points on your license',
  '6-month license suspension',
  'Possible ignition interlock requirement',
];

const secondDuiPenalties = [
  'Up to 2 years in jail',
  'Fines up to $2,000',
  '8 points on your license',
  '1-year license suspension',
  'Mandatory ignition interlock',
];

const thirdDuiPenalties = [
  'Up to 3 years in jail',
  'Fines up to $3,000',
  '12 points (automatic license revocation)',
  '18-month license suspension',
  'Extended ignition interlock requirement',
];

const commonDefenses = [
  { text: 'Illegal traffic stop', subtext: 'If the stop was unlawful, evidence may be suppressed.' },
  { text: 'Faulty breathalyzer', subtext: 'Machines must be calibrated and procedures followed.' },
  { text: 'Improper field sobriety tests', subtext: 'Deviations from standardized procedures can invalidate results.' },
  { text: 'Rising BAC defense', subtext: 'BAC may have been legal while driving but rose by test time.' },
  { text: 'Medical conditions', subtext: 'Some conditions can cause false positives or misleading observations.' },
  { text: 'Chain of custody issues', subtext: 'Blood samples must be properly handled and stored.' },
];

const timeSensitiveItems = [
  '30 days to request an MVA hearing',
  'Evidence and witness memories fade quickly',
  'Early intervention can sometimes prevent formal charges',
];
---

<PracticeAreaLayout
  title="DUI/DWI Defense Lawyer in Pikesville, MD"
  description="Experienced DUI defense attorneys in Maryland. We fight to protect your license, minimize penalties, and defend your rights. Free consultation available 24/7."
  heroTitle="DUI/DWI Defense Lawyers in Maryland"
  heroDescription="A DUI charge can threaten your freedom, your license, and your future. Our experienced defense attorneys fight aggressively to protect your rights and minimize the impact on your life."
  category="criminal-defense"
  faqs={faqs}
  relatedServices={relatedServices}
  breadcrumbs={breadcrumbs}
  heroImage="/images/stock/courtroom-empty.jpg"
  accentColor="red"
>
  <h2>Aggressive DUI/DWI Defense in Maryland</h2>
  <p>
    Being charged with DUI (Driving Under the Influence) or DWI (Driving While Impaired) in Maryland 
    is a serious matter with potentially life-altering consequences. At the Law Offices of Alex Poberesky, 
    we understand what's at stake and fight tirelessly to protect your rights, your license, and your future.
  </p>
  <p>
    Our experienced criminal defense attorneys have successfully defended hundreds of DUI cases throughout 
    Maryland. We know the law, we know the science behind breath and blood testing, and we know how to 
    challenge the prosecution's evidence effectively.
  </p>

  <h3>Understanding DUI vs. DWI in Maryland</h3>
  <p>
    Maryland distinguishes between DUI and DWI based on your level of impairment:
  </p>
  <IconList items={duiVsDwi} columns={2} variant="card" />
  <p>
    Both charges carry serious penalties, but DUI is considered the more severe offense. Commercial drivers 
    face even stricter standards with a BAC limit of 0.04%.
  </p>

  <h3>Penalties for DUI/DWI in Maryland</h3>
  <StatHighlight stats={firstOffensePenaltyStats} variant="cards" columns={3} />
  <p><strong>First DUI Offense:</strong></p>
  <IconList items={firstDuiPenalties} columns={2} />

  <p><strong>Second DUI Offense:</strong></p>
  <IconList items={secondDuiPenalties} columns={2} />

  <p><strong>Third or Subsequent DUI Offense:</strong></p>
  <IconList items={thirdDuiPenalties} columns={2} />

  <CalloutBox title="Critical 30-Day Deadline" variant="warning">
    <p class="mb-0">
      <strong>You have only 30 days from your arrest</strong> to request an MVA hearing to challenge your license suspension. 
      Missing this deadline can result in automatic suspension. Contact us immediately to protect your driving privileges.
    </p>
  </CalloutBox>

  <h3>The Two-Front Battle: MVA and Criminal Court</h3>
  <p>
    A DUI arrest triggers two separate proceedings in Maryland:
  </p>
  <StepCards 
    steps={[
      { title: 'MVA Administrative Hearing', description: 'Challenge your license suspension within 30 days of arrest' },
      { title: 'Criminal Court Proceedings', description: 'The state prosecutes DUI/DWI charges which can result in jail time and fines' },
    ]} 
    columns={2} 
    variant="numbered" 
  />
  <p>
    We represent clients at both proceedings, fighting to protect your driving privileges and your freedom.
  </p>

  <h3>Common DUI Defenses</h3>
  <p>Our attorneys thoroughly investigate every aspect of your case to identify the strongest defenses:</p>
  <IconList items={commonDefenses} columns={2} variant="card" />

  <h3>Maryland's Ignition Interlock Program</h3>
  <p>
    Maryland's Ignition Interlock Program can allow you to continue driving during a suspension by 
    installing a breathalyzer device in your vehicle. The device requires you to provide a breath 
    sample before starting your car and at random intervals while driving.
  </p>
  <p>
    While participation in the program comes with costs and restrictions, it can be preferable to 
    losing your ability to drive entirely. We can advise you on whether this program is right for 
    your situation.
  </p>

  <h3>Why Time Is Critical</h3>
  <p>
    After a DUI arrest, you face strict deadlines that can significantly impact your case:
  </p>
  <IconList items={timeSensitiveItems} columns={2} />
  <p>
    Contact us immediately after your arrest. We offer 24/7 availability for DUI emergencies because 
    we understand that timing can make the difference in your case.
  </p>

  <h3>Why Choose Our DUI Defense Team</h3>
  <p>
    With over 26 years defending clients against DUI charges in Maryland, we have the experience and 
    knowledge to fight for the best possible outcome. We've handled hundreds of DUI cases and know 
    how to challenge the prosecution's evidence effectively. Your initial consultation is free and 
    confidential.
  </p>
</PracticeAreaLayout>
