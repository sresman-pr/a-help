---
import PracticeAreaLayout from '../layouts/PracticeAreaLayout.astro';
import { personalInjuryServices } from '../data/services';
import StepCards from '../components/ui/StepCards.astro';
import IconList from '../components/ui/IconList.astro';
import CalloutBox from '../components/ui/CalloutBox.astro';
import StatHighlight from '../components/ui/StatHighlight.astro';

const faqs = [
  {
    question: 'What should I do immediately after a car accident in Maryland?',
    answer: 'First, check for injuries and call 911 if needed. Move to safety if possible, exchange information with other drivers, take photos of the scene and damage, get witness contact information, and seek medical attention even if you feel fine. Most importantly, don\'t admit fault and contact an attorney before speaking with insurance companies.'
  },
  {
    question: 'How long do I have to file a car accident claim in Maryland?',
    answer: 'Maryland has a three-year statute of limitations for car accident claims. However, you should contact an attorney as soon as possible to preserve evidence and protect your rights.'
  },
  {
    question: 'What if the other driver doesn\'t have insurance?',
    answer: 'You may still be able to recover compensation through your own uninsured/underinsured motorist coverage. We can help you navigate this process and maximize your recovery.'
  },
  {
    question: 'How much is my car accident case worth?',
    answer: 'The value depends on many factors including the severity of injuries, medical expenses, lost wages, pain and suffering, and long-term impacts. We provide free case evaluations to help you understand your potential compensation.'
  },
  {
    question: 'Should I accept the insurance company\'s settlement offer?',
    answer: 'You should consult with an attorney before accepting any settlement. Insurance companies often offer low initial settlements hoping you\'ll accept before understanding the full value of your claim. We can negotiate on your behalf to maximize your compensation.'
  }
];

const relatedServices = personalInjuryServices.filter(s => 
  ['truck-accidents', 'motorcycle-accidents', 'pedestrian-accidents'].includes(s.slug)
);

const breadcrumbs = [
  { label: 'Personal Injury', href: '/personal-injury/' },
  { label: 'Car Accidents' }
];

const accidentSteps = [
  { title: 'Check for Injuries', description: 'Call 911 if anyone needs medical attention' },
  { title: 'Move to Safety', description: 'If possible, move vehicles out of traffic' },
  { title: 'Exchange Information', description: 'Get details from all other drivers involved' },
  { title: 'Document the Scene', description: 'Take photos of vehicles, damage, and road conditions' },
  { title: 'Get Witness Info', description: 'Collect contact details from anyone who saw the accident' },
  { title: 'Seek Medical Care', description: 'Get checked even if you feel fine—injuries can appear later' },
  { title: 'Contact an Attorney', description: 'Speak with a lawyer before talking to insurance companies' },
];

const accidentCauses = [
  { text: 'Distracted driving', subtext: 'Texting, phone calls, eating while driving' },
  { text: 'Drunk driving (DUI)', subtext: 'Alcohol and drug-impaired driving' },
  { text: 'Speeding', subtext: 'Exceeding limits or too fast for conditions' },
  { text: 'Reckless driving', subtext: 'Aggressive driving, tailgating, illegal passing' },
  { text: 'Failure to yield', subtext: 'Running red lights and stop signs' },
  { text: 'Weather-related', subtext: 'Rain, snow, ice, fog conditions' },
];

const compensationItems = [
  'Medical expenses (emergency care, hospitalization, surgery, rehabilitation)',
  'Future medical costs for ongoing treatment',
  'Lost wages and loss of earning capacity',
  'Pain and suffering',
  'Emotional distress',
  'Vehicle repair or replacement costs',
  'Loss of enjoyment of life'
];

const stats = [
  { value: '26+', label: 'Years Experience' },
  { value: '100s', label: 'Cases Won' },
  { value: '$0', label: 'Upfront Cost' },
];
---

<PracticeAreaLayout
  title="Car Accident Lawyer in Pikesville, MD"
  description="Experienced car accident attorneys in Maryland. We fight for maximum compensation for your injuries, lost wages, and pain and suffering. Free consultation."
  heroTitle="Car Accident Lawyers in Maryland"
  heroDescription="When you've been injured in a car accident, you need an experienced attorney who will fight for every dollar you deserve. We handle all aspects of your case while you focus on recovery."
  category="personal-injury"
  faqs={faqs}
  relatedServices={relatedServices}
  breadcrumbs={breadcrumbs}
  heroImage="/images/stock/road-highway.jpg"
  accentColor="gold"
>
  <h2>Experienced Car Accident Representation in Maryland</h2>
  <p>
    Car accidents in Maryland can be devastating, causing severe injuries that may affect you for years 
    or even a lifetime. At the Law Offices of Alex Poberesky, we understand the physical, emotional, 
    and financial toll a car accident can take on you and your family.
  </p>
  <p>
    Our experienced car accident attorneys have been helping victims throughout Maryland recover 
    fair compensation for over 26 years. We handle everything from minor fender-benders to serious 
    collisions involving catastrophic injuries.
  </p>

  <StatHighlight stats={stats} variant="cards" columns={3} />

  <h3>What to Do After a Car Accident</h3>
  <p>
    If you're physically able, taking the right steps immediately after an accident can significantly 
    impact your ability to recover compensation:
  </p>

  <StepCards steps={accidentSteps} columns={3} variant="numbered" />

  <h3>Common Causes of Car Accidents</h3>
  <p>We handle car accident cases involving:</p>
  
  <IconList items={accidentCauses} columns={2} variant="card" />

  <h3>Compensation Available in Car Accident Cases</h3>
  <p>Depending on your case, you may be entitled to recover:</p>
  
  <IconList items={compensationItems} icon="check" variant="default" />

  <CalloutBox title="Maryland's Contributory Negligence Rule" variant="warning">
    <p>
      Maryland is one of only a few states that follow a strict contributory negligence rule. This means 
      if you're found <strong>even 1% at fault</strong> for the accident, you may be barred from recovering any compensation.
    </p>
    <p>
      Insurance companies often try to shift blame onto victims to avoid paying claims. Our attorneys 
      know how to build strong cases that clearly establish the other party's fault and protect your 
      right to full compensation.
    </p>
  </CalloutBox>

  <h3>Why Choose Our Car Accident Lawyers</h3>
  <p>
    With over 26 years of experience handling car accident cases in Maryland, we have the knowledge 
    and resources to take on insurance companies and fight for maximum compensation. We work on a 
    contingency fee basis, meaning you pay nothing unless we win your case.
  </p>
</PracticeAreaLayout>
