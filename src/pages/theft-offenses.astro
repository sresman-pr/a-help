---
import PracticeAreaLayout from '../layouts/PracticeAreaLayout.astro';
import { criminalDefenseServices } from '../data/services';
import IconList from '../components/ui/IconList.astro';
import StatHighlight from '../components/ui/StatHighlight.astro';

const faqs = [
  {
    question: 'What is the difference between theft, burglary, and robbery in Maryland?',
    answer: 'Theft is taking property without consent. Burglary is entering a building with intent to commit a crime inside. Robbery is theft using force or threat of force against a person. Each has different elements and penalties, with robbery generally being the most serious due to the violent component.'
  },
  {
    question: 'What are the penalties for shoplifting in Maryland?',
    answer: 'Shoplifting penalties depend on the value of items taken. Under $100 is a misdemeanor with up to 90 days jail and $500 fine. $100-$1,500 carries up to 6 months and $500 fine. Over $1,500 can be a felony with up to 5 years and $10,000 fine. Prior convictions can enhance penalties.'
  },
  {
    question: 'Can I be charged with theft if I intended to return the item?',
    answer: 'Intent to permanently deprive the owner is an element of theft. However, prosecutors may argue your intent based on circumstances, and "borrowing" without permission can still constitute theft. Each case depends on specific facts that an attorney can evaluate.'
  },
  {
    question: 'Will a theft conviction appear on my background check?',
    answer: 'Yes, theft convictions appear on criminal background checks and can affect employment, housing, and professional licensing. Depending on the circumstances, some theft charges may be eligible for expungement after a waiting period. We fight to minimize these long-term consequences.'
  },
  {
    question: 'What if I was falsely accused of theft?',
    answer: 'False theft accusations happen more often than people realize, particularly in retail settings with mistaken identity or misunderstandings. We thoroughly investigate every case, review surveillance footage, interview witnesses, and challenge weak evidence to defend your reputation.'
  }
];

const relatedServices = criminalDefenseServices.filter(s => 
  ['assault', 'drug-crimes', 'domestic-violence'].includes(s.slug)
);

const breadcrumbs = [
  { label: 'Criminal Defense', href: '/criminal-defense/' },
  { label: 'Theft Offenses Defense' }
];

const theftThresholdStats = [
  { value: '$1,500', label: 'Felony Starts', description: 'Many theft allegations become felonies at $1,500+.' },
  { value: '$25,000', label: 'Higher Tier', description: 'Penalties increase significantly at $25,000+.' },
  { value: '$100,000', label: 'Top Tier', description: 'The most severe theft tier begins at $100,000+.' },
];

const theftUnder100 = ['Misdemeanor', 'Up to 90 days in jail', 'Fine up to $500'];
const theft100to1500 = ['Misdemeanor', 'Up to 6 months in jail', 'Fine up to $500'];
const theft1500to25k = ['Felony', 'Up to 5 years in prison', 'Fine up to $10,000'];
const theft25kto100k = ['Felony', 'Up to 10 years in prison', 'Fine up to $15,000'];
const theftOver100k = ['Felony', 'Up to 20 years in prison', 'Fine up to $25,000'];

const burglaryFirstDegree = [
  'Breaking and entering a dwelling (home)',
  'With intent to commit theft or a crime of violence',
  'Up to 20 years in prison',
];

const burglarySecondDegree = [
  'Breaking and entering a storehouse or other structure',
  'With intent to commit theft, arson, or crime of violence',
  'Up to 15 years in prison',
];

const burglaryThirdDegree = [
  'Breaking and entering a dwelling with intent to commit any crime',
  'Up to 10 years in prison',
];

const burglaryFourthDegree = [
  'Being in or on the yard of a dwelling or storehouse with intent to commit theft',
  'Possessing burglary tools',
  'Up to 3 years in prison',
];

const robberyPenalties = [
  { text: 'Robbery', subtext: 'Up to 15 years in prison' },
  { text: 'Armed robbery', subtext: 'Up to 20 years in prison' },
  { text: 'Carjacking', subtext: 'Up to 30 years in prison' },
  { text: 'Armed carjacking', subtext: 'Up to 30 years; minimum 5 years without parole if firearm used' },
];

const theftDefenses = [
  { text: 'Mistaken identity', subtext: "You weren't the person who committed the theft" },
  { text: 'Lack of intent', subtext: "Misunderstanding, accident, or no intent to steal" },
  { text: 'Claim of right', subtext: 'You believed you had a right to the property' },
  { text: 'Consent', subtext: 'The owner gave you permission' },
  { text: 'Insufficient evidence', subtext: "The state can't prove every element beyond a reasonable doubt" },
  { text: 'Constitutional violations', subtext: 'Evidence obtained through illegal searches' },
  { text: 'Duress', subtext: 'You were forced under threat' },
  { text: 'Value disputes', subtext: 'Challenging alleged value to reduce charge severity' },
];

const consequencesBeyondCourt = [
  { text: 'Employment', subtext: 'Theft convictions can be especially damaging for positions involving money or trust' },
  { text: 'Professional licenses', subtext: 'Licensing boards may deny or revoke licenses' },
  { text: 'Housing', subtext: 'Landlords often reject applicants with theft records' },
  { text: 'Education', subtext: 'Can affect admissions and financial aid' },
  { text: 'Immigration', subtext: 'May be treated as a crime of moral turpitude' },
  { text: 'Civil liability', subtext: 'Victims may sue for damages in addition to criminal penalties' },
];

const firstTimeOptions = [
  { text: 'Probation Before Judgment (PBJ)', subtext: 'No conviction on your record if you complete probation successfully' },
  { text: 'Diversion programs', subtext: 'Complete requirements and have charges dismissed (when eligible)' },
  { text: 'Community service', subtext: 'In lieu of jail time in some cases' },
  { text: 'Restitution agreements', subtext: 'Paying back the victim as part of a negotiated resolution' },
];
---

<PracticeAreaLayout
  title="Theft Offenses Defense Lawyer in Pikesville, MD"
  description="Experienced theft defense attorneys in Maryland. We defend shoplifting, burglary, robbery, and all theft charges. Protect your record with a free consultation."
  heroTitle="Theft Offenses Defense in Maryland"
  heroDescription="Theft charges—from shoplifting to robbery—can result in jail time and a criminal record that follows you for life. Our experienced defense attorneys fight to protect your freedom and your future."
  category="criminal-defense"
  faqs={faqs}
  relatedServices={relatedServices}
  breadcrumbs={breadcrumbs}
  heroImage="/images/stock/courtroom-empty.jpg"
  accentColor="red"
>
  <h2>Experienced Theft Defense in Maryland</h2>
  <p>
    Theft charges in Maryland range from minor shoplifting offenses to serious felonies like robbery 
    and burglary. Regardless of the charge level, a theft conviction can have lasting consequences 
    for your employment, housing, and reputation. At the Law Offices of Alex Poberesky, we provide 
    aggressive defense for all theft-related charges throughout Maryland.
  </p>
  <p>
    Our criminal defense attorneys understand that theft cases often involve misunderstandings, 
    mistaken identity, or circumstances that don't tell the whole story. We thoroughly investigate 
    every case and fight to protect your rights and your future.
  </p>

  <h3>Types of Theft Offenses We Defend</h3>
  <p>We handle all theft-related criminal charges, including:</p>
  <IconList
    items={[
      { text: 'Shoplifting', subtext: 'Retail theft allegations' },
      { text: 'Theft (by value)', subtext: 'Charges scale based on the value prosecutors claim' },
      { text: 'Burglary', subtext: 'Entering a structure with intent to commit a crime inside' },
      { text: 'Robbery', subtext: 'Theft using force or threat of force (felony)' },
      { text: 'Armed robbery', subtext: 'Robbery involving a dangerous weapon' },
      { text: 'Carjacking / auto theft', subtext: 'Vehicle-related theft allegations' },
      { text: 'Identity theft / fraud', subtext: 'Financial crimes involving alleged deception' },
      { text: 'Embezzlement', subtext: 'Allegations of theft by someone entrusted with property' },
      { text: 'Receiving stolen property', subtext: 'Knowingly possessing stolen items' },
    ]}
    columns={2}
    variant="card"
  />

  <h3>Maryland Theft Penalties by Value</h3>
  <p>
    Maryland's theft penalties are primarily based on the value of property taken:
  </p>
  <StatHighlight stats={theftThresholdStats} variant="centered" columns={3} />

  <h4>Theft Under $100</h4>
  <IconList items={theftUnder100} columns={2} />

  <h4>Theft $100 - $1,500</h4>
  <IconList items={theft100to1500} columns={2} />

  <h4>Theft $1,500 - $25,000</h4>
  <IconList items={theft1500to25k} columns={2} />

  <h4>Theft $25,000 - $100,000</h4>
  <IconList items={theft25kto100k} columns={2} />

  <h4>Theft Over $100,000</h4>
  <IconList items={theftOver100k} columns={2} />

  <h3>Burglary in Maryland</h3>
  <p>
    Burglary involves breaking and entering a structure with intent to commit a crime inside. Maryland 
    recognizes different degrees:
  </p>
  
  <h4>First Degree Burglary</h4>
  <IconList items={burglaryFirstDegree} columns={2} />

  <h4>Second Degree Burglary</h4>
  <IconList items={burglarySecondDegree} columns={2} />

  <h4>Third Degree Burglary</h4>
  <IconList items={burglaryThirdDegree} columns={2} />

  <h4>Fourth Degree Burglary</h4>
  <IconList items={burglaryFourthDegree} columns={2} />

  <h3>Robbery in Maryland</h3>
  <p>
    Robbery is theft accomplished through force or threat of force. It's always a felony:
  </p>
  <IconList items={robberyPenalties} columns={2} variant="card" />

  <h3>Defenses to Theft Charges</h3>
  <p>We explore every possible defense strategy:</p>
  <IconList items={theftDefenses} columns={2} variant="card" />

  <h3>Consequences Beyond Criminal Penalties</h3>
  <p>A theft conviction affects many areas of your life:</p>
  <IconList items={consequencesBeyondCourt} columns={2} variant="card" />

  <h3>First-Time Offender Options</h3>
  <p>
    For first-time offenders, Maryland offers several alternatives that may avoid a conviction:
  </p>
  <IconList items={firstTimeOptions} columns={2} variant="card" />
  <p>
    We work to identify all available alternatives and advocate for resolutions that protect your record.
  </p>

  <h3>Why Choose Our Theft Defense Team</h3>
  <p>
    With over 26 years of criminal defense experience in Maryland, we know how to effectively challenge 
    theft charges and protect our clients' futures. We've successfully defended clients facing charges 
    from minor shoplifting to serious robbery cases. Contact us for a free, confidential consultation 
    to discuss your case.
  </p>
</PracticeAreaLayout>
