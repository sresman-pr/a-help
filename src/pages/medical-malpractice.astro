---
import PracticeAreaLayout from '../layouts/PracticeAreaLayout.astro';
import { personalInjuryServices } from '../data/services';
import StepCards from '../components/ui/StepCards.astro';
import IconList from '../components/ui/IconList.astro';
import CalloutBox from '../components/ui/CalloutBox.astro';
import StatHighlight from '../components/ui/StatHighlight.astro';

const faqs = [
  {
    question: 'What qualifies as medical malpractice in Maryland?',
    answer: 'Medical malpractice occurs when a healthcare provider deviates from the accepted standard of care, causing injury to a patient. This can include misdiagnosis, surgical errors, medication mistakes, birth injuries, and failure to treat conditions properly.'
  },
  {
    question: 'How long do I have to file a medical malpractice claim?',
    answer: 'Maryland generally has a three-year statute of limitations for medical malpractice claims from the date of injury. However, in some cases where the injury wasn\'t immediately discoverable, you have three years from when you discovered (or should have discovered) the injury, up to a maximum of five years.'
  },
  {
    question: 'Do I need an expert witness for my medical malpractice case?',
    answer: 'Yes. Maryland requires a certificate of qualified expert before filing most medical malpractice lawsuits. The expert must attest that the defendant breached the standard of care and caused your injury. We work with qualified medical experts to build strong cases.'
  },
  {
    question: 'Can I sue a hospital for medical malpractice?',
    answer: 'Yes. Hospitals can be held liable for their employees\' negligence, inadequate staffing, improper equipment maintenance, and failure to ensure patient safety. We investigate all potentially liable parties to maximize your recovery.'
  }
];

const relatedServices = personalInjuryServices.filter(s => 
  ['dental-malpractice', 'nursing-home-neglect', 'wrongful-death'].includes(s.slug)
);

const breadcrumbs = [
  { label: 'Personal Injury', href: '/personal-injury/' },
  { label: 'Medical Malpractice' }
];

const malpracticeTypes = [
  { text: 'Misdiagnosis or delayed diagnosis', subtext: 'Failing to identify conditions in time' },
  { text: 'Surgical errors', subtext: 'Wrong-site surgery, surgical tool left inside, nerve damage' },
  { text: 'Medication errors', subtext: 'Wrong medication, dosage, or dangerous interactions' },
  { text: 'Birth injuries', subtext: 'Cerebral palsy, Erb\'s palsy, brain damage during delivery' },
  { text: 'Anesthesia errors', subtext: 'Overdose, failure to monitor, allergic reactions' },
  { text: 'Emergency room errors', subtext: 'Failure to treat, premature discharge' },
  { text: 'Failure to obtain informed consent', subtext: 'Performing procedures without proper consent' },
  { text: 'Hospital-acquired infections', subtext: 'Preventable infections from poor sanitation' },
];

const liableParties = [
  'Doctors and physicians',
  'Surgeons',
  'Anesthesiologists',
  'Nurses and nursing staff',
  'Hospitals and medical facilities',
  'Pharmacists',
  'Laboratories and diagnostic centers',
  'Medical device manufacturers'
];

const marylandRequirements = [
  { title: 'Expert Certificate', description: 'A certificate of qualified expert is required before filing suit' },
  { title: 'Damages Caps', description: 'Maryland caps non-economic damages in malpractice cases' },
  { title: '3-Year Limit', description: 'Statute of limitations generally 3 years, with some exceptions' },
  { title: 'Standard of Care', description: 'Must prove the provider deviated from accepted practice' },
];

const recoveryItems = [
  'Medical expenses for corrective treatment',
  'Future medical care and rehabilitation',
  'Lost wages and earning capacity',
  'Pain and suffering (subject to Maryland\'s caps)',
  'Loss of enjoyment of life',
  'In cases of death, wrongful death damages'
];

const stats = [
  { value: '#3', label: 'Cause of Death', description: 'Medical errors in the U.S.' },
  { value: '26+', label: 'Years Experience' },
  { value: '$0', label: 'Unless We Win' },
];
---

<PracticeAreaLayout
  title="Medical Malpractice Lawyer in Pikesville, MD"
  description="Experienced medical malpractice attorneys in Maryland. Misdiagnosis, surgical errors, birth injuries, hospital negligence. Free consultation."
  heroTitle="Medical Malpractice Lawyers in Maryland"
  heroDescription="When healthcare providers fail in their duty to provide competent care, patients suffer. We hold negligent doctors, hospitals, and healthcare facilities accountable."
  category="personal-injury"
  faqs={faqs}
  relatedServices={relatedServices}
  breadcrumbs={breadcrumbs}
  heroImage="/images/stock/hospital-corridor.jpg"
  accentColor="blue"
>
  <h2>Holding Healthcare Providers Accountable</h2>
  <p>
    When you seek medical care, you trust that healthcare providers will treat you competently and 
    safely. Unfortunately, medical errors occur far too often, causing serious injuries and even death. 
    Medical malpractice is the third leading cause of death in the United States.
  </p>
  <p>
    At the Law Offices of Alex Poberesky, we represent patients and families harmed by medical 
    negligence. These complex cases require significant resources and expertise, and we have both.
  </p>

  <StatHighlight stats={stats} variant="cards" columns={3} />

  <h3>Types of Medical Malpractice We Handle</h3>
  
  <IconList items={malpracticeTypes} columns={2} variant="default" />

  <h3>Who Can Be Held Liable?</h3>
  <p>Medical malpractice claims may be filed against:</p>
  
  <IconList items={liableParties} columns={2} icon="chevron" variant="card" />

  <CalloutBox title="Maryland Medical Malpractice Requirements" variant="navy">
    <p>
      Maryland has specific requirements for medical malpractice cases that make having an experienced 
      attorney essential. Understanding these requirements is crucial to protecting your rights.
    </p>
  </CalloutBox>

  <StepCards steps={marylandRequirements} columns={4} variant="numbered" />

  <h3>What You May Recover</h3>
  <p>Compensation in medical malpractice cases may include:</p>
  
  <IconList items={recoveryItems} icon="check" variant="default" />

  <CalloutBox title="Free Case Evaluation" variant="info">
    <p>
      Medical malpractice cases are complex and require extensive investigation. We offer a free, 
      confidential consultation to review your case and explain your legal options. If we take your 
      case, you pay nothing unless we win.
    </p>
  </CalloutBox>
</PracticeAreaLayout>
