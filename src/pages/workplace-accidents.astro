---
import PracticeAreaLayout from '../layouts/PracticeAreaLayout.astro';
import { personalInjuryServices } from '../data/services';
import IconList from '../components/ui/IconList.astro';
import StepCards from '../components/ui/StepCards.astro';

const faqs = [
  {
    question: 'What is a third-party workplace injury claim?',
    answer: 'A third-party claim allows you to sue someone other than your employer for a workplace injury. While workers\' comp limits claims against employers, you can still sue third parties like equipment manufacturers, subcontractors, property owners, or negligent drivers whose actions caused your injury.'
  },
  {
    question: 'Can I file both a workers\' comp claim and a third-party lawsuit?',
    answer: 'Yes. Workers\' compensation and third-party claims serve different purposes. Workers\' comp provides immediate benefits regardless of fault, while third-party claims allow you to recover full damages including pain and suffering. You may be entitled to both, but coordination is important to maximize your recovery.'
  },
  {
    question: 'Who can be held liable as a third party in workplace accidents?',
    answer: 'Potential third parties include manufacturers of defective equipment, property owners (if different from your employer), general contractors (if you work for a subcontractor), other subcontractors, drivers who cause accidents, and any other party whose negligence contributed to your injury.'
  },
  {
    question: 'What types of compensation are available in third-party claims that aren\'t in workers\' comp?',
    answer: 'Workers\' comp only covers medical expenses and partial wage replacement. Third-party claims allow you to recover pain and suffering, full lost wages, emotional distress, permanent disability, loss of enjoyment of life, and potentially punitive damages—significantly more than workers\' comp alone.'
  },
  {
    question: 'What if my employer doesn\'t have workers\' compensation insurance?',
    answer: 'Maryland law requires most employers to carry workers\' comp insurance. If your employer is uninsured, you may be able to sue them directly (the exclusive remedy rule doesn\'t protect uninsured employers), or file a claim with the Uninsured Employers\' Fund. Contact an attorney to explore your options.'
  }
];

const relatedServices = personalInjuryServices.filter(s => 
  ['workers-compensation', 'product-liability', 'wrongful-death'].includes(s.slug)
);

const breadcrumbs = [
  { label: 'Personal Injury', href: '/personal-injury/' },
  { label: 'Workplace Accidents' }
];

const thirdPartyClaimSteps = [
  { title: 'Report & Treat', description: 'Report the injury and get medical care right away.' },
  { title: 'Start Workers’ Comp', description: 'Open the workers’ compensation claim to secure immediate benefits.' },
  { title: 'Preserve Evidence', description: 'Save equipment, photos, incident reports, and witness information.' },
  { title: 'Investigate Third Parties', description: 'Identify negligent contractors, owners, drivers, or manufacturers.' },
  { title: 'Build Damages Proof', description: 'Document lost wages, future care needs, and long-term impacts.' },
  { title: 'Negotiate or Litigate', description: 'Pursue settlement or trial to recover full damages beyond workers’ comp.' },
];

const workplaceAccidentTypes = [
  { text: 'Falls', subtext: 'Ladders, scaffolds, rooftops, and elevated platforms' },
  { text: 'Struck-by incidents', subtext: 'Falling tools/materials or moving equipment' },
  { text: 'Caught-in/between', subtext: 'Crushing injuries from machinery or collapsing structures' },
  { text: 'Electrocution', subtext: 'Power lines, wiring, and faulty equipment' },
  { text: 'Vehicle and forklift crashes', subtext: 'Warehouses, loading docks, and work zones' },
  { text: 'Defective equipment', subtext: 'Unsafe tools, guards, or machine failures' },
];

const highRiskIndustries = [
  { text: 'Construction', subtext: 'Falls, struck-by accidents, electrocution, caught-between' },
  { text: 'Manufacturing', subtext: 'Machinery accidents, chemical exposure, repetitive stress' },
  { text: 'Transportation and warehousing', subtext: 'Forklift accidents, loading dock falls, vehicle crashes' },
  { text: 'Healthcare', subtext: 'Patient handling injuries, needle sticks, workplace violence' },
  { text: 'Oil and gas', subtext: 'Explosions, fires, equipment failures' },
  { text: 'Agriculture', subtext: 'Machinery accidents and chemical exposure' },
];

const commonInjuries = [
  { text: 'Traumatic brain injuries', subtext: 'Falls and struck-by incidents' },
  { text: 'Spinal cord injuries', subtext: 'Falls from heights and crushing accidents' },
  { text: 'Amputations', subtext: 'Machinery accidents and power tool injuries' },
  { text: 'Burns', subtext: 'Chemical, electrical, and thermal burns' },
  { text: 'Fractures', subtext: 'Falls, crush injuries, and impacts' },
  { text: 'Electrocution injuries', subtext: 'Contact with power lines or electrical equipment' },
  { text: 'Toxic exposure', subtext: 'Asbestos, chemicals, fumes' },
  { text: 'Hearing loss', subtext: 'Prolonged noise exposure' },
  { text: 'Wrongful death', subtext: 'Fatal workplace accidents' },
];

const fatalFour = [
  { text: 'Falls', subtext: 'From scaffolds, ladders, roofs, and other heights' },
  { text: 'Struck-by objects', subtext: 'Falling tools, materials, or equipment' },
  { text: 'Electrocution', subtext: 'Contact with power lines or faulty wiring' },
  { text: 'Caught-in/between', subtext: 'Crushing injuries from machinery or collapsing structures' },
];

const thirdPartyCompensation = [
  'Full lost wages (not just partial replacement)',
  'Pain and suffering',
  'Emotional distress',
  'Permanent disability and disfigurement',
  'Loss of enjoyment of life',
  'Loss of consortium (impact on family relationships)',
  'Future medical expenses',
  'Punitive damages in cases of egregious negligence (when available)',
];
---

<PracticeAreaLayout
  title="Workplace Accident Lawyer in Pikesville, MD"
  description="Experienced workplace accident attorneys in Maryland. We handle third-party claims for construction, industrial, and other workplace injuries. Free consultation."
  heroTitle="Workplace Accident Lawyers in Maryland"
  heroDescription="When third-party negligence causes your workplace injury, you deserve more than workers' comp. We fight to hold all responsible parties accountable and maximize your recovery."
  category="personal-injury"
  faqs={faqs}
  relatedServices={relatedServices}
  breadcrumbs={breadcrumbs}
  heroImage="/images/stock/construction-cranes.jpg"
  accentColor="teal"
>
  <h2>Third-Party Workplace Accident Attorneys in Maryland</h2>
  <p>
    Workplace injuries can be devastating, and while workers' compensation provides some benefits, 
    it often falls far short of covering all your damages. When a third party—someone other than 
    your employer—caused or contributed to your injury, you may have additional legal options that 
    provide significantly more compensation.
  </p>
  <p>
    At the Law Offices of Alex Poberesky, we have over 26 years of experience helping injured 
    workers navigate both workers' compensation and third-party claims. We fight to ensure you 
    receive every dollar you're entitled to from all responsible parties.
  </p>

  <h3>Understanding Third-Party Workplace Claims</h3>
  <p>
    Workers' compensation is a "no-fault" system—you receive benefits regardless of who caused 
    the accident, but in exchange, you generally cannot sue your employer. However, this 
    "exclusive remedy" rule does not protect third parties whose negligence injured you.
  </p>
  <p>
    Third-party claims allow you to recover full damages, including pain and suffering, which 
    are not available under workers' comp. Common third-party defendants include:
  </p>
  <StepCards steps={thirdPartyClaimSteps} columns={3} variant="numbered" />

  <IconList
    items={[
      { text: 'Equipment manufacturers', subtext: 'Defective machinery, tools, or safety equipment' },
      { text: 'Property owners', subtext: "Dangerous conditions on premises you're working at" },
      { text: 'General contractors', subtext: 'Negligent site coordination or safety failures' },
      { text: 'Other subcontractors', subtext: 'Negligence by other trades on a jobsite' },
      { text: 'Motor vehicle drivers', subtext: 'Work-zone and delivery-related crashes' },
      { text: 'Architects and engineers', subtext: 'Design defects that create dangerous conditions' },
      { text: 'Maintenance companies', subtext: 'Negligent maintenance or inspections' },
    ]}
    columns={2}
    variant="card"
  />

  <h3>Common Types of Workplace Accidents</h3>
  <p>Many serious workplace injuries involve hazards like:</p>
  <IconList items={workplaceAccidentTypes} columns={2} variant="card" />

  <h3>High-Risk Industries for Workplace Accidents</h3>
  <p>Some industries have higher rates of serious workplace injuries:</p>
  <IconList items={highRiskIndustries} columns={2} variant="card" />

  <h3>Common Types of Workplace Injuries</h3>
  <IconList items={commonInjuries} columns={2} variant="card" />

  <h3>Construction Site Accidents</h3>
  <p>
    Construction sites are among the most dangerous workplaces. OSHA identifies the "Fatal Four" 
    causes of construction deaths:
  </p>
  <IconList items={fatalFour} columns={2} variant="card" />
  <p>
    Multiple contractors and subcontractors on construction sites create numerous opportunities 
    for third-party claims when one party's negligence injures another's workers.
  </p>

  <h3>Compensation Available in Third-Party Claims</h3>
  <p>Unlike workers' comp, third-party claims allow you to recover:</p>
  <IconList items={thirdPartyCompensation} columns={2} />

  <h3>Coordinating Workers' Comp and Third-Party Claims</h3>
  <p>
    Pursuing both workers' compensation and a third-party claim requires careful coordination. 
    Your workers' comp carrier has a lien on any third-party recovery, but this can often be 
    negotiated. Our attorneys understand how to maximize your total recovery while properly 
    addressing workers' comp liens.
  </p>
  <p>
    If you've been injured at work and believe a third party may be responsible, contact us for 
    a free consultation. We'll evaluate your case and explain all your legal options for 
    obtaining full compensation for your injuries.
  </p>
</PracticeAreaLayout>
