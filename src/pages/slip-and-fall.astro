---
import PracticeAreaLayout from '../layouts/PracticeAreaLayout.astro';
import { personalInjuryServices } from '../data/services';
import IconList from '../components/ui/IconList.astro';
import CalloutBox from '../components/ui/CalloutBox.astro';

const faqs = [
  {
    question: 'What do I need to prove in a slip and fall case?',
    answer: 'You must prove: (1) a dangerous condition existed on the property, (2) the property owner knew or should have known about it, (3) they failed to fix it or warn you, and (4) the condition caused your injury. Maryland\'s contributory negligence rule means you must show you weren\'t partially at fault.'
  },
  {
    question: 'How long do I have to file a slip and fall claim in Maryland?',
    answer: 'Maryland has a three-year statute of limitations for premises liability claims. However, evidence can disappear quickly, so you should contact an attorney as soon as possible to preserve your case.'
  },
  {
    question: 'What if I fell on government property?',
    answer: 'Claims against government entities have shorter deadlines and special procedures. You typically must file a notice of claim within one year. These cases are complex and require an attorney experienced with government liability.'
  },
  {
    question: 'Can I still recover if I was partially at fault?',
    answer: 'Maryland\'s contributory negligence rule is very strict. If you were even 1% at fault, you may be barred from recovery. This is why having an experienced attorney who can build a strong case is critical.'
  }
];

const relatedServices = personalInjuryServices.filter(s => 
  ['workers-compensation', 'workplace-accidents', 'nursing-home-neglect'].includes(s.slug)
);

const breadcrumbs = [
  { label: 'Personal Injury', href: '/personal-injury/' },
  { label: 'Slip and Fall' }
];

const commonLocations = [
  'Grocery stores and retail shops',
  'Restaurants and bars',
  'Shopping malls',
  'Office buildings',
  'Apartment complexes',
  'Hospitals and nursing homes',
  'Parking garages and lots',
  'Government buildings',
  'Hotels and resorts',
];

const commonInjuries = [
  { text: 'Broken hips', subtext: 'Especially common in elderly victims' },
  { text: 'Wrist and arm fractures', subtext: 'Often from trying to break the fall' },
  { text: 'Head and brain injuries', subtext: 'Concussions and traumatic brain injuries' },
  { text: 'Back and spinal injuries', subtext: 'Herniated discs, spinal trauma' },
  { text: 'Knee and ankle injuries', subtext: 'Sprains, tears, fractures' },
  { text: 'Soft tissue injuries', subtext: 'Strains, sprains, tears' },
  { text: 'Cuts and lacerations', subtext: 'From impact with surfaces or objects' },
];

const investigationSteps = [
  'Reviewing security camera footage',
  'Interviewing witnesses',
  'Examining maintenance records',
  'Documenting the hazardous condition',
  'Consulting with safety experts',
];
---

<PracticeAreaLayout
  title="Slip and Fall Lawyer in Pikesville, MD"
  description="Experienced slip and fall attorneys in Maryland. Premises liability, wet floors, uneven surfaces, icy sidewalks. We fight for fair compensation. Free consultation."
  heroTitle="Slip and Fall Lawyers in Maryland"
  heroDescription="Property owners have a duty to keep their premises safe. When they fail and you're injured, we hold them accountable and fight for the compensation you deserve."
  category="personal-injury"
  faqs={faqs}
  relatedServices={relatedServices}
  breadcrumbs={breadcrumbs}
  heroImage="/images/stock/hero-courthouse.jpg"
  accentColor="gold"
>
  <h2>Maryland Premises Liability Attorneys</h2>
  <p>
    Slip and fall accidents can cause serious injuries including broken bones, head trauma, and 
    back injuries. Property owners—whether businesses, landlords, or homeowners—have a legal duty 
    to maintain safe conditions for visitors.
  </p>
  <p>
    At the Law Offices of Alex Poberesky, we hold negligent property owners accountable when their 
    failure to maintain safe premises causes injuries. We have extensive experience handling 
    premises liability cases throughout Maryland.
  </p>

  <h3>Common Causes of Slip and Fall Accidents</h3>
  <IconList
    items={[
      { text: 'Wet or slippery floors', subtext: 'Spills, recently mopped floors, leaks' },
      { text: 'Uneven surfaces', subtext: 'Broken sidewalks, potholes, torn carpeting' },
      { text: 'Ice and snow', subtext: 'Failure to clear walkways and entry areas' },
      { text: 'Poor lighting', subtext: 'Inadequate illumination in stairwells and parking lots' },
      { text: 'Defective stairs', subtext: 'Broken handrails, loose steps, missing treads' },
      { text: 'Cluttered walkways', subtext: 'Merchandise, cords, debris blocking paths' },
      { text: 'Parking lot hazards', subtext: 'Potholes, unmarked curbs, oil slicks' },
    ]}
    columns={2}
    variant="card"
  />

  <h3>Where Slip and Fall Accidents Occur</h3>
  <IconList items={commonLocations} columns={2} variant="card" />

  <h3>Common Slip and Fall Injuries</h3>
  <IconList items={commonInjuries} columns={2} variant="card" />

  <h3>Proving Your Case</h3>
  <CalloutBox title="What We Must Prove" variant="info">
    <p class="mb-2">
      In a Maryland slip and fall case, the details matter. We work to prove:
    </p>
    <ol class="mb-0">
      <li>A dangerous condition existed on the property</li>
      <li>The owner knew or should have known about it</li>
      <li>They failed to fix it or warn you</li>
      <li>The condition caused your injuries and damages</li>
    </ol>
  </CalloutBox>
  <p>
    Successful slip and fall cases require proving that the property owner knew or should have 
    known about the dangerous condition. We investigate thoroughly to establish liability, including:
  </p>
  <IconList items={investigationSteps} columns={2} />
</PracticeAreaLayout>
