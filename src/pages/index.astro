---
import PageLayout from '../layouts/PageLayout.astro';
import Hero from '../components/sections/Hero.astro';
import ServiceCards from '../components/sections/ServiceCards.astro';
import WhyChooseUs from '../components/sections/WhyChooseUs.astro';
import AttorneyStory from '../components/sections/AttorneyStory.astro';
import CTASection from '../components/sections/CTASection.astro';
import FAQAccordion from '../components/sections/FAQAccordion.astro';

import { featuredServices } from '../data/services';

/*
  HOMEPAGE STRUCTURE (10 sections → 6)
  Visual rhythm: DARK → LIGHT → DARK → LIGHT → LIGHT → DARK
  
  1. Hero (DARK) - Background image + form
  2. ServiceCards (LIGHT) - Practice areas with image cards
  3. WhyChooseUs (DARK) - 4 key stats with counters
  4. AttorneyStory (LIGHT) - Visual timeline + testimonials
  5. FAQ (LIGHT-ALT) - 3 key questions
  6. CTA (DARK) - Background image
*/

// Reduced to 3 most critical FAQs
const homeFaqs = [
  {
    question: 'What does it cost to hire a personal injury lawyer?',
    answer: 'We work on a contingency fee basis, which means you pay nothing unless we win your case. Our fee is a percentage of the settlement or verdict we obtain for you. There are no upfront costs or hidden fees.'
  },
  {
    question: 'How long do I have to file an accident claim in Maryland?',
    answer: 'In Maryland, you generally have three years from the date of the accident to file a personal injury claim. However, certain circumstances may affect this deadline, so it\'s best to consult with an attorney as soon as possible to protect your rights.'
  },
  {
    question: 'Can I still recover damages if I was partially at fault?',
    answer: 'Maryland follows a strict contributory negligence rule. If you are found even 1% at fault for the accident, you may be barred from recovering any damages. This is why it\'s crucial to have an experienced attorney who can build a strong case on your behalf.'
  }
];
---

<PageLayout 
  title="Maryland Personal Injury & Criminal Defense Lawyer"
  description="Experienced Maryland personal injury and criminal defense attorney with 26+ years of success. Free consultation, no fee unless we win. Call (410) 484-0400."
>
  <!-- 1. HERO (DARK) - Background image + courthouse -->
  <Hero 
    title="Injured? Get the Justice You Deserve."
    subtitle="Maryland's Trusted Personal Injury & Criminal Defense Firm"
    description="With over 26 years of experience and a near-perfect success rate, we fight relentlessly for our clients. From car accidents to criminal charges, we're here for you 24/7."
    showForm={true}
    showStats={true}
    variant="home"
  />
  
  <!-- 2. SERVICE CARDS (LIGHT) - All 10 practice areas like original site -->
  <ServiceCards 
    services={featuredServices}
    title="Our Legal Services"
    subtitle="How We Can Help You"
    columns={5}
    variant="image-cards"
  />
  
  <!-- 3. WHY CHOOSE US (DARK) - 4 key stats -->
  <WhyChooseUs />
  
  <!-- 4. ATTORNEY STORY (LIGHT) - Timeline + testimonials -->
  <AttorneyStory showTestimonials={true} />
  
  <!-- 5. FAQ (LIGHT-ALT) - 3 critical questions -->
  <div class="section-light-alt">
    <FAQAccordion 
      faqs={homeFaqs}
      title="Frequently Asked Questions"
      subtitle="Get answers to common questions"
    />
  </div>
  
  <!-- 6. FINAL CTA (DARK) - Background image -->
  <CTASection 
    title="Ready to Fight for Your Rights?"
    description="Don't wait to get the legal help you need. Contact us today for a free, no-obligation case evaluation. We're available 24/7."
    variant="centered"
  />
</PageLayout>
