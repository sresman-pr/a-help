---
interface Props {
  variant?: 'light' | 'dark';
  compact?: boolean;
  compactOnMobile?: boolean;
}

const { variant = 'light', compact = false, compactOnMobile = false } = Astro.props;
const isDark = variant === 'dark';
const hideEmailOnMobile = compactOnMobile && !compact;
---

<form 
  action="https://api.web3forms.com/submit" 
  method="POST"
  class={`space-y-2 sm:space-y-3 ${compactOnMobile ? 'sm:mt-0' : ''}`}
>
  <!-- Web3Forms Access Key - Replace with actual key -->
  <input type="hidden" name="access_key" value="YOUR_ACCESS_KEY_HERE" />
  <input type="hidden" name="subject" value="Quick Lead from AlexHelp.com" />
  <input type="hidden" name="redirect" value="https://www.alexhelp.com/thank-you/" />
  <input type="hidden" name="from_name" value="AlexHelp Website - Quick Form" />
  
  <!-- Honeypot for spam prevention -->
  <input type="checkbox" name="botcheck" class="hidden" style="display: none;" />
  
  <div>
    <input 
      type="text" 
      name="name" 
      required 
      placeholder="Your Name *"
      class={`w-full px-4 py-2.5 sm:py-3 rounded-lg transition-all ${isDark 
        ? 'bg-white/10 border border-white/20 text-white placeholder:text-gray-400 focus:bg-white/15 focus:border-gold-500 focus:outline-none' 
        : 'form-input'}`}
    />
  </div>
  
  <div>
    <input 
      type="tel" 
      name="phone" 
      required 
      placeholder="Phone Number *"
      class={`w-full px-4 py-2.5 sm:py-3 rounded-lg transition-all ${isDark 
        ? 'bg-white/10 border border-white/20 text-white placeholder:text-gray-400 focus:bg-white/15 focus:border-gold-500 focus:outline-none' 
        : 'form-input'}`}
    />
  </div>
  
  {!compact && (
    <div class={hideEmailOnMobile ? 'hidden sm:block' : ''}>
      <input 
        type="email" 
        name="email" 
        required 
        placeholder="Email Address *"
        class={`w-full px-4 py-2.5 sm:py-3 rounded-lg transition-all ${isDark 
          ? 'bg-white/10 border border-white/20 text-white placeholder:text-gray-400 focus:bg-white/15 focus:border-gold-500 focus:outline-none' 
          : 'form-input'}`}
      />
    </div>
  )}
  
  <button 
    type="submit" 
    class="btn btn-primary w-full mt-2"
  >
    Get Free Consultation
  </button>
</form>
