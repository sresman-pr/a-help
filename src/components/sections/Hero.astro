---
import { Phone, ArrowRight, Check } from '@lucide/astro';
import LeadCaptureForm from '../forms/LeadCaptureForm.astro';

interface Props {
  title: string;
  subtitle?: string;
  description?: string;
  showForm?: boolean;
  showStats?: boolean;
  showAttorneyPhoto?: boolean;
  variant?: 'home' | 'page';
  backgroundImage?: string;
}

const { 
  title, 
  subtitle,
  description,
  showForm = true,
  showStats = true,
  showAttorneyPhoto = true,
  variant = 'home',
  backgroundImage
} = Astro.props;

const stats = [
  { value: '26+', label: 'Years Experience' },
  { value: '100s', label: 'Cases Won' },
  { value: '24/7', label: 'Availability' },
];

const trustPoints = [
  'Free Consultation',
  'No Fee Unless We Win',
  'Multilingual Staff'
];

const attorneyPhotoUrl = 'https://www.alexhelp.com/wp-content/uploads/2022/06/Banner-Image-1.png';
---

<section class={`relative overflow-hidden ${variant === 'home' ? 'bg-gradient-animated text-white' : 'bg-gray-50'}`}>
  <!-- Decorative Background Elements -->
  {variant === 'home' && (
    <>
      <div class="absolute inset-0 bg-pattern-grid-light opacity-30"></div>
      <div class="absolute top-20 left-10 w-72 h-72 rounded-full bg-gold-500/10 blur-3xl animate-float-slow"></div>
      <div class="absolute bottom-10 right-20 w-96 h-96 rounded-full bg-navy-500/20 blur-3xl animate-float-delay"></div>
      <div class="absolute top-1/2 left-1/4 w-2 h-2 rounded-full bg-gold-400/50 animate-float"></div>
      <div class="absolute top-1/3 right-1/3 w-3 h-3 rounded-full bg-gold-400/30 animate-float-delay"></div>
    </>
  )}
  
  {backgroundImage && (
    <div class="absolute inset-0">
      <img src={backgroundImage} alt="" class="w-full h-full object-cover opacity-20" />
    </div>
  )}
  
  <div class="container-custom relative">
    <div class={`grid ${showForm ? 'lg:grid-cols-2' : 'lg:grid-cols-1'} gap-12 items-center ${variant === 'home' ? 'py-16 md:py-24' : 'py-12 md:py-16'}`}>
      <!-- Content -->
      <div class={showForm ? '' : 'max-w-3xl mx-auto text-center'}>
        {subtitle && (
          <p class={`text-lg font-medium mb-4 ${variant === 'home' ? 'text-gold-400' : 'text-gold-600'}`}>
            <span class="inline-flex items-center gap-2">
              <span class="w-8 h-px bg-gold-400"></span>
              {subtitle}
            </span>
          </p>
        )}
        
        <h1 class={`font-heading font-bold mb-6 ${variant === 'home' ? 'text-white' : 'text-navy-900'}`}>
          {title}
        </h1>
        
        {description && (
          <p class={`text-lg md:text-xl mb-8 ${variant === 'home' ? 'text-gray-300' : 'text-gray-600'}`}>
            {description}
          </p>
        )}
        
        <!-- Trust Points -->
        {variant === 'home' && (
          <div class="flex flex-wrap gap-4 mb-8">
            {trustPoints.map((point) => (
              <div class="flex items-center gap-2 bg-white/5 backdrop-blur-sm px-3 py-1.5 rounded-full border border-white/10">
                <div class="w-5 h-5 rounded-full bg-gold-500 flex items-center justify-center">
                  <Check class="w-3 h-3 text-navy-900" />
                </div>
                <span class="text-gray-200 text-sm">{point}</span>
              </div>
            ))}
          </div>
        )}
        
        <!-- CTA Buttons -->
        <div class={`flex flex-wrap gap-4 ${!showForm ? 'justify-center' : ''}`}>
          <a href="/contact-us/" class="btn btn-primary btn-glow shadow-elevated">
            Free Case Review
            <ArrowRight class="w-5 h-5" />
          </a>
          <a href="tel:+14104840400" class={`btn ${variant === 'home' ? 'btn-outline' : 'btn-secondary'}`}>
            <Phone class="w-5 h-5" />
            (410) 484-0400
          </a>
        </div>
        
        <!-- Stats -->
        {showStats && variant === 'home' && (
          <div class="grid grid-cols-3 gap-6 mt-12 pt-8 border-t border-white/20">
            {stats.map((stat) => (
              <div class="text-center">
                <div class="stat-number text-3xl md:text-4xl">{stat.value}</div>
                <div class="text-sm text-gray-400 mt-1">{stat.label}</div>
              </div>
            ))}
          </div>
        )}
      </div>
      
      <!-- Form with Attorney Photo -->
      {showForm && (
        <div class="relative">
          <!-- Attorney Photo (visible on larger screens, positioned behind/beside form) -->
          {showAttorneyPhoto && variant === 'home' && (
            <div class="hidden xl:block absolute -right-8 -bottom-8 w-48 h-64 z-0">
              <div class="relative w-full h-full">
                <div class="absolute inset-0 bg-gradient-to-t from-navy-900 via-transparent to-transparent z-10 rounded-xl"></div>
                <img 
                  src={attorneyPhotoUrl}
                  alt="Alex Poberesky - Maryland Personal Injury Attorney"
                  class="w-full h-full object-cover object-top rounded-xl opacity-40"
                />
              </div>
            </div>
          )}
          
          <!-- Form Card -->
          <div class="relative z-10 bg-white rounded-2xl p-6 md:p-8 shadow-floating glow-gold-subtle">
            <div class="absolute -top-3 left-6 badge-premium">
              <span class="text-xs">Free Consultation</span>
            </div>
            <h2 class="font-heading font-bold text-xl md:text-2xl text-navy-900 mb-2 mt-2">
              Free Case Evaluation
            </h2>
            <p class="text-gray-600 mb-6">
              Get started with a free, no-obligation consultation
            </p>
            <LeadCaptureForm />
            <p class="text-xs text-gray-500 text-center mt-4">
              We respond to most inquiries within 15 minutes during business hours.
            </p>
          </div>
        </div>
      )}
    </div>
  </div>
  
  <!-- Bottom Decorative Wave -->
  {variant === 'home' && (
    <div class="absolute bottom-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-gold-500/50 to-transparent"></div>
  )}
</section>
