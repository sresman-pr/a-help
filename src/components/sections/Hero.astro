---
import { Phone, ArrowRight, Check } from '@lucide/astro';
import LeadCaptureForm from '../forms/LeadCaptureForm.astro';

interface Props {
  title: string;
  subtitle?: string;
  description?: string;
  mobileDescription?: string;
  showForm?: boolean;
  variant?: 'home' | 'page';
  backgroundImage?: string;
}

const { 
  title, 
  subtitle,
  description,
  mobileDescription,
  showForm = true,
  variant = 'home',
  backgroundImage = '/images/stock/hero-courthouse.jpg'
} = Astro.props;

const trustPoints = [
  'Free Consultation',
  'No Fee Unless We Win',
  'Multilingual Staff'
];
---

<section class={`relative overflow-hidden ${variant === 'home' ? 'section-dark' : 'bg-gray-50'}`}>
  <!-- Background Image with Overlay -->
  {variant === 'home' && (
    <div class="absolute inset-0">
      <img 
        src={backgroundImage} 
        alt="" 
        class="w-full h-full object-cover"
        loading="eager"
      />
      <div class="absolute inset-0 bg-navy-900/80"></div>
      <div class="absolute inset-0 bg-gradient-to-r from-navy-900/60 via-navy-900/40 to-navy-900/70"></div>
    </div>
  )}
  
  <div class="container-custom relative">
    <div class={`grid ${showForm ? 'lg:grid-cols-5' : 'lg:grid-cols-1'} gap-5 lg:gap-6 items-center ${variant === 'home' ? 'py-10 md:py-14' : 'py-6 md:py-8'}`}>
      <!-- Content - Takes more space -->
      <div class={showForm ? 'lg:col-span-3' : 'max-w-3xl mx-auto text-center'}>
        {subtitle && (
          <p class={`text-base md:text-lg font-medium mb-1 ${variant === 'home' ? 'text-gold-400' : 'text-gold-600'}`}>
            <span class="inline-flex items-center gap-2">
              <span class="w-10 h-px bg-gold-500"></span>
              {subtitle}
            </span>
          </p>
        )}
        
        <h1 class={`font-heading font-bold mb-2 leading-tight sm:leading-normal ${variant === 'home' ? 'text-white' : 'text-navy-900'}`}>
          {title}
        </h1>
        
        {description && (
          <p class={`text-base sm:text-lg md:text-xl mb-3 leading-relaxed max-w-2xl ${variant === 'home' ? 'text-gray-300' : 'text-gray-600'}`}>
            {mobileDescription ? (
              <>
                <span class="md:hidden">{mobileDescription}</span>
                <span class="hidden md:inline">{description}</span>
              </>
            ) : (
              description
            )}
          </p>
        )}
        
        <!-- Trust Points -->
        {variant === 'home' && (
          <div class="hidden sm:flex flex-wrap gap-2 mb-3">
            {trustPoints.map((point) => (
              <div class="flex items-center gap-2 bg-white/10 backdrop-blur-sm px-2.5 py-1 rounded-full border border-white/20">
                <div class="w-4 h-4 rounded-full bg-gold-500 flex items-center justify-center">
                  <Check class="w-2.5 h-2.5 text-navy-900" />
                </div>
                <span class="text-white text-sm font-medium">{point}</span>
              </div>
            ))}
          </div>
        )}
        
        <!-- CTA Buttons -->
        <div class={`flex flex-col sm:flex-row gap-2 ${!showForm ? 'justify-center' : ''}`}>
          <a href="/contact-us/" class="btn btn-primary btn-glow shadow-elevated w-full sm:w-auto">
            Free Case Review
            <ArrowRight class="w-5 h-5" />
          </a>
          <a href="tel:+14104840400" class={`btn w-full sm:w-auto hidden sm:flex ${variant === 'home' ? 'btn-outline-white' : 'btn-secondary'}`}>
            <Phone class="w-5 h-5" />
            (410) 484-0400
          </a>
        </div>
      </div>
      
      <!-- Form Column - Dark glass style to match hero -->
      {showForm && (
        <div class="lg:col-span-2 hidden sm:block">
          <div class="bg-white/10 backdrop-blur-md rounded-2xl p-2.5 sm:p-3 md:p-4 border border-white/20 max-w-sm mx-auto lg:mx-0 lg:ml-auto">
            <h2 class="font-heading font-bold text-lg text-white mb-1">
              Free Case Evaluation
            </h2>
            <p class="text-gray-300 text-xs mb-3">
              Get a free, no-obligation consultation
            </p>
            <LeadCaptureForm variant="dark" compactOnMobile={true} />
            <p class="text-xs text-gray-400 text-center mt-2">
              Response within 15 minutes
            </p>
          </div>
        </div>
      )}
    </div>
  </div>
  
  <!-- Bottom gradient line -->
  {variant === 'home' && (
    <div class="absolute bottom-0 left-0 right-0 h-1 bg-gradient-to-r from-transparent via-gold-500 to-transparent opacity-50"></div>
  )}
</section>
