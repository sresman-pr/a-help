---
import { Phone, ArrowRight, Check } from '@lucide/astro';
import LeadCaptureForm from '../forms/LeadCaptureForm.astro';

interface Props {
  title: string;
  subtitle?: string;
  description?: string;
  showForm?: boolean;
  showStats?: boolean;
  variant?: 'home' | 'page';
  backgroundImage?: string;
}

const { 
  title, 
  subtitle,
  description,
  showForm = true,
  showStats = true,
  variant = 'home',
  backgroundImage
} = Astro.props;

const stats = [
  { value: '26+', label: 'Years Experience' },
  { value: '100s', label: 'Cases Won' },
  { value: '24/7', label: 'Availability' },
];

const trustPoints = [
  'Free Consultation',
  'No Fee Unless We Win',
  'Multilingual Staff'
];
---

<section class={`relative overflow-hidden ${variant === 'home' ? 'bg-gradient-navy text-white' : 'bg-gray-50'}`}>
  {backgroundImage && (
    <div class="absolute inset-0">
      <img src={backgroundImage} alt="" class="w-full h-full object-cover opacity-20" />
    </div>
  )}
  
  <div class="container-custom relative">
    <div class={`grid ${showForm ? 'lg:grid-cols-2' : 'lg:grid-cols-1'} gap-12 items-center ${variant === 'home' ? 'py-16 md:py-24' : 'py-12 md:py-16'}`}>
      <!-- Content -->
      <div class={showForm ? '' : 'max-w-3xl mx-auto text-center'}>
        {subtitle && (
          <p class={`text-lg font-medium mb-4 ${variant === 'home' ? 'text-gold-400' : 'text-gold-600'}`}>
            {subtitle}
          </p>
        )}
        
        <h1 class={`font-heading font-bold mb-6 ${variant === 'home' ? 'text-white' : 'text-navy-900'}`}>
          {title}
        </h1>
        
        {description && (
          <p class={`text-lg md:text-xl mb-8 ${variant === 'home' ? 'text-gray-300' : 'text-gray-600'}`}>
            {description}
          </p>
        )}
        
        <!-- Trust Points -->
        {variant === 'home' && (
          <div class="flex flex-wrap gap-4 mb-8">
            {trustPoints.map((point) => (
              <div class="flex items-center gap-2">
                <div class="w-5 h-5 rounded-full bg-gold-500 flex items-center justify-center">
                  <Check class="w-3 h-3 text-navy-900" />
                </div>
                <span class="text-gray-200">{point}</span>
              </div>
            ))}
          </div>
        )}
        
        <!-- CTA Buttons -->
        <div class={`flex flex-wrap gap-4 ${!showForm ? 'justify-center' : ''}`}>
          <a href="/contact-us/" class="btn btn-primary">
            Free Case Review
            <ArrowRight class="w-5 h-5" />
          </a>
          <a href="tel:+14104840400" class={`btn ${variant === 'home' ? 'btn-outline' : 'btn-secondary'}`}>
            <Phone class="w-5 h-5" />
            (410) 484-0400
          </a>
        </div>
        
        <!-- Stats -->
        {showStats && variant === 'home' && (
          <div class="grid grid-cols-3 gap-6 mt-12 pt-8 border-t border-white/20">
            {stats.map((stat) => (
              <div class="text-center">
                <div class="text-3xl md:text-4xl font-bold text-gold-400">{stat.value}</div>
                <div class="text-sm text-gray-400 mt-1">{stat.label}</div>
              </div>
            ))}
          </div>
        )}
      </div>
      
      <!-- Form -->
      {showForm && (
        <div class="bg-white rounded-2xl p-6 md:p-8 shadow-2xl">
          <h2 class="font-heading font-bold text-xl md:text-2xl text-navy-900 mb-2">
            Free Case Evaluation
          </h2>
          <p class="text-gray-600 mb-6">
            Get started with a free, no-obligation consultation
          </p>
          <LeadCaptureForm />
          <p class="text-xs text-gray-500 text-center mt-4">
            We respond to most inquiries within 15 minutes during business hours.
          </p>
        </div>
      )}
    </div>
  </div>
</section>
