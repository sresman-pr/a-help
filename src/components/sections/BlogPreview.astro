---
import { ArrowRight, Calendar } from '@lucide/astro';

interface BlogPost {
  title: string;
  description: string;
  href: string;
  date: string;
  category: string;
  image?: string;
}

interface Props {
  posts: BlogPost[];
  title?: string;
  subtitle?: string;
}

const { 
  posts, 
  title = 'Latest News & Insights',
  subtitle = 'Stay informed about legal matters'
} = Astro.props;

// Format date helper
const formatDate = (dateStr: string) => {
  return new Date(dateStr).toLocaleDateString('en-US', {
    month: 'short',
    day: 'numeric',
    year: 'numeric'
  });
};
---

<section class="section-padding">
  <div class="container-custom">
    <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-4 mb-12">
      <div>
        {subtitle && (
          <p class="text-gold-600 font-medium mb-2">{subtitle}</p>
        )}
        {title && (
          <h2 class="font-heading font-bold text-navy-900">{title}</h2>
        )}
      </div>
      <a href="/blog/" class="btn btn-outline self-start md:self-auto">
        View All Posts
        <ArrowRight class="w-5 h-5" />
      </a>
    </div>
    
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {posts.map((post) => (
        <a 
          href={post.href}
          class="group bg-white rounded-xl overflow-hidden border border-gray-200 card-hover"
        >
          {post.image ? (
            <div class="aspect-video bg-gray-100 overflow-hidden">
              <img 
                src={post.image} 
                alt={post.title}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
              />
            </div>
          ) : (
            <div class="aspect-video bg-gradient-navy flex items-center justify-center">
              <span class="text-gold-500 font-heading font-bold text-4xl">A</span>
            </div>
          )}
          
          <div class="p-6">
            <div class="flex items-center gap-3 text-sm text-gray-500 mb-3">
              <span class="px-2 py-1 bg-gold-50 text-gold-700 rounded-full text-xs font-medium">
                {post.category}
              </span>
              <div class="flex items-center gap-1">
                <Calendar class="w-4 h-4" />
                {formatDate(post.date)}
              </div>
            </div>
            
            <h3 class="font-heading font-bold text-navy-900 mb-2 group-hover:text-gold-600 transition-colors line-clamp-2">
              {post.title}
            </h3>
            
            <p class="text-gray-600 text-sm line-clamp-2">
              {post.description}
            </p>
            
            <div class="mt-4 flex items-center text-gold-600 font-medium text-sm group-hover:text-gold-500">
              Read More
              <ArrowRight class="w-4 h-4 ml-1 group-hover:translate-x-1 transition-transform" />
            </div>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
