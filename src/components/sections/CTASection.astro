---
import { Phone, ArrowRight } from '@lucide/astro';

interface Props {
  title?: string;
  subtitle?: string;
  description?: string;
  variant?: 'default' | 'centered' | 'split';
  showPhone?: boolean;
  primaryCTA?: {
    text: string;
    href: string;
  };
  secondaryCTA?: {
    text: string;
    href: string;
  };
}

const { 
  title = "Ready to Fight for Your Rights?",
  subtitle,
  description = "Contact us today for a free, no-obligation case evaluation. We're here to help you get the justice and compensation you deserve.",
  variant = 'default',
  showPhone = true,
  primaryCTA = { text: 'Free Case Review', href: '/contact-us/' },
  secondaryCTA
} = Astro.props;
---

<section class="bg-gradient-animated text-white section-padding relative overflow-hidden">
  <!-- Decorative Elements -->
  <div class="absolute inset-0 bg-pattern-grid-light opacity-10"></div>
  <div class="absolute top-0 left-1/4 w-64 h-64 rounded-full bg-gold-500/10 blur-3xl"></div>
  <div class="absolute bottom-0 right-1/4 w-80 h-80 rounded-full bg-navy-500/30 blur-3xl"></div>
  
  <!-- Top border gradient -->
  <div class="absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-gold-500/50 to-transparent"></div>
  
  <div class="container-custom relative">
    {variant === 'centered' ? (
      <div class="max-w-3xl mx-auto text-center">
        {subtitle && (
          <p class="text-gold-400 font-medium mb-2">{subtitle}</p>
        )}
        <h2 class="font-heading font-bold text-white mb-4">{title}</h2>
        {description && (
          <p class="text-gray-300 text-lg mb-8">{description}</p>
        )}
        <div class="flex flex-wrap justify-center gap-4">
          <a href={primaryCTA.href} class="btn btn-primary btn-glow shadow-elevated">
            {primaryCTA.text}
            <ArrowRight class="w-5 h-5" />
          </a>
          {showPhone && (
            <a href="tel:+14104840400" class="btn btn-outline">
              <Phone class="w-5 h-5" />
              (410) 484-0400
            </a>
          )}
          {secondaryCTA && (
            <a href={secondaryCTA.href} class="btn btn-outline">
              {secondaryCTA.text}
            </a>
          )}
        </div>
      </div>
    ) : variant === 'split' ? (
      <div class="grid md:grid-cols-2 gap-8 items-center">
        <div>
          {subtitle && (
            <p class="text-gold-400 font-medium mb-2">{subtitle}</p>
          )}
          <h2 class="font-heading font-bold text-white mb-4">{title}</h2>
          {description && (
            <p class="text-gray-300">{description}</p>
          )}
        </div>
        <div class="flex flex-wrap md:justify-end gap-4">
          <a href={primaryCTA.href} class="btn btn-primary btn-glow shadow-elevated">
            {primaryCTA.text}
            <ArrowRight class="w-5 h-5" />
          </a>
          {showPhone && (
            <a href="tel:+14104840400" class="btn btn-outline">
              <Phone class="w-5 h-5" />
              (410) 484-0400
            </a>
          )}
        </div>
      </div>
    ) : (
      <div class="flex flex-col md:flex-row items-center justify-between gap-8">
        <div class="md:max-w-2xl">
          {subtitle && (
            <p class="text-gold-400 font-medium mb-2">{subtitle}</p>
          )}
          <h2 class="font-heading font-bold text-white mb-2">{title}</h2>
          {description && (
            <p class="text-gray-300">{description}</p>
          )}
        </div>
        <div class="flex flex-wrap gap-4">
          <a href={primaryCTA.href} class="btn btn-primary btn-glow shadow-elevated whitespace-nowrap">
            {primaryCTA.text}
            <ArrowRight class="w-5 h-5" />
          </a>
          {showPhone && (
            <a href="tel:+14104840400" class="btn btn-outline whitespace-nowrap">
              <Phone class="w-5 h-5" />
              Call Now
            </a>
          )}
        </div>
      </div>
    )}
  </div>
  
  <!-- Bottom border gradient -->
  <div class="absolute bottom-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-gold-500/50 to-transparent"></div>
</section>
