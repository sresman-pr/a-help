---
import { Phone, ArrowRight, Check, Scale, Shield } from '@lucide/astro';

const credibilityItems = [
  { text: 'Serving Maryland Since 1998', highlight: false },
  { text: 'Millions Recovered for Clients', highlight: true },
  { text: 'Aggressive Criminal Defense Representation', highlight: false },
  { text: 'Available 24/7', highlight: false }
];
---

<section class="relative overflow-hidden section-dark">
  <!-- Background with subtle gradient -->
  <div class="absolute inset-0 bg-gradient-to-br from-navy-900 via-navy-800 to-navy-900"></div>
  <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,_var(--tw-gradient-stops))] from-gold-500/5 via-transparent to-transparent"></div>
  
  <div class="container-custom relative">
    <!-- Reduced vertical padding by ~12% for scroll hint -->
    <div class="grid lg:grid-cols-5 gap-6 lg:gap-10 items-center py-10 md:py-12 lg:py-14">
      
      <!-- Left Column - Content (60%) - Increased whitespace priority -->
      <div class="lg:col-span-3 order-2 lg:order-1 lg:pr-4">
        
        <!-- Optional subtle pre-header -->
        <p class="text-gold-500/80 text-sm font-medium tracking-wide uppercase mb-3">
          Maryland Legal Advocacy
        </p>
        
        <!-- H1 Tagline - Line break for rhythm, tighter line-height -->
        <h1 class="font-heading font-bold text-white mb-5 hero-headline">
          <span class="block">When Your Future</span>
          <span class="block">Is at Stake.</span>
        </h1>
        
        <!-- Subheadline - Improved contrast and weight for readability -->
        <p class="text-xl md:text-2xl lg:text-[1.375rem] text-gray-100 font-medium mb-6 leading-relaxed max-w-xl">
          Personal Injury and Criminal Defense Representation for Maryland Clients Since 1998.
        </p>
        
        <!-- Primary CTAs - Clear hierarchy: Gold dominant, Navy secondary -->
        <div class="flex flex-col sm:flex-row gap-3 mb-6">
          <a href="/contact-us/" class="btn btn-primary btn-lg btn-glow shadow-elevated">
            Free Case Evaluation
            <ArrowRight class="w-5 h-5" />
          </a>
          <a href="tel:+14104840400" class="btn btn-secondary-dark btn-lg">
            <Phone class="w-5 h-5" />
            Call 24/7: (410) 484-0400
          </a>
        </div>
        
        <!-- Practice Split Quick Links -->
        <div class="flex flex-col sm:flex-row gap-3">
          <a 
            href="/personal-injury/" 
            class="group flex items-center gap-3 bg-white/5 hover:bg-white/10 border border-white/10 hover:border-gold-500/50 rounded-xl px-4 py-2.5 transition-all duration-300"
          >
            <div class="w-9 h-9 bg-gold-500/20 rounded-lg flex items-center justify-center group-hover:bg-gold-500/30 transition-colors">
              <Shield class="w-4 h-4 text-gold-400" />
            </div>
            <div>
              <span class="text-white font-semibold text-sm block">Injured?</span>
              <span class="text-gray-400 text-xs">Get compensation</span>
            </div>
            <ArrowRight class="w-3.5 h-3.5 text-gray-500 group-hover:text-gold-400 ml-auto transition-colors" />
          </a>
          
          <a 
            href="/criminal-defense/" 
            class="group flex items-center gap-3 bg-white/5 hover:bg-white/10 border border-white/10 hover:border-gold-500/50 rounded-xl px-4 py-2.5 transition-all duration-300"
          >
            <div class="w-9 h-9 bg-gold-500/20 rounded-lg flex items-center justify-center group-hover:bg-gold-500/30 transition-colors">
              <Scale class="w-4 h-4 text-gold-400" />
            </div>
            <div>
              <span class="text-white font-semibold text-sm block">Charged with a Crime?</span>
              <span class="text-gray-400 text-xs">Protect your rights</span>
            </div>
            <ArrowRight class="w-3.5 h-3.5 text-gray-500 group-hover:text-gold-400 ml-auto transition-colors" />
          </a>
        </div>
      </div>
      
      <!-- Right Column - Photo & Credibility (40%) -->
      <div class="lg:col-span-2 order-1 lg:order-2">
        <div class="relative max-w-xs mx-auto lg:max-w-none">
          <!-- Photo Container -->
          <div class="relative rounded-2xl overflow-hidden shadow-2xl">
            <img 
              src="/images/alex-poberesky.png"
              alt="Alex Poberesky, Maryland Personal Injury and Criminal Defense Attorney"
              class="w-full aspect-[3/4] object-cover object-top"
              width="400"
              height="533"
              loading="eager"
              fetchpriority="high"
            />
            <!-- Subtle gradient overlay at bottom for name -->
            <div class="absolute inset-0 bg-gradient-to-t from-navy-900/90 via-navy-900/20 to-transparent"></div>
            
            <!-- Name Overlay - Reduced size (~15%) for better rhythm with bullet stack -->
            <div class="absolute bottom-0 left-0 right-0 p-5">
              <h2 class="font-heading font-bold text-lg lg:text-xl text-white mb-0.5">
                Alex Poberesky, Esq.
              </h2>
              <p class="text-gold-400 text-xs font-medium">Founder & Lead Attorney</p>
            </div>
          </div>
          
          <!-- Credibility Stack - Below Photo with improved spacing -->
          <div class="mt-5 space-y-2.5">
            {credibilityItems.map((item) => (
              <div class={`flex items-center gap-3 ${item.highlight ? 'credibility-highlight' : ''}`}>
                <div class={`w-5 h-5 rounded-full flex items-center justify-center flex-shrink-0 ${item.highlight ? 'bg-gold-400' : 'bg-gold-500'}`}>
                  <Check class="w-3 h-3 text-navy-900" />
                </div>
                <span class={`text-sm font-medium ${item.highlight ? 'text-gold-300' : 'text-gray-300'}`}>
                  {item.text}
                </span>
              </div>
            ))}
          </div>
        </div>
      </div>
      
    </div>
  </div>
  
  <!-- Bottom gradient line -->
  <div class="absolute bottom-0 left-0 right-0 h-1 bg-gradient-to-r from-transparent via-gold-500 to-transparent opacity-50"></div>
</section>

<style>
  /* Hero headline - tighter line-height for premium feel */
  .hero-headline {
    line-height: 0.95;
    letter-spacing: -0.015em;
  }
  
  @media (min-width: 768px) {
    .hero-headline {
      line-height: 0.92;
    }
  }
  
  /* Secondary dark button style for phone CTA */
  :global(.btn-secondary-dark) {
    background-color: var(--navy-700);
    color: white;
    border: 1px solid var(--navy-600);
  }
  
  :global(.btn-secondary-dark:hover) {
    background-color: var(--navy-600);
    border-color: var(--navy-500);
  }
  
  /* Subtle highlight for "Millions Recovered" bullet */
  .credibility-highlight {
    position: relative;
  }
  
  .credibility-highlight::before {
    content: '';
    position: absolute;
    left: -8px;
    right: -8px;
    top: -4px;
    bottom: -4px;
    background: linear-gradient(90deg, var(--gold-500) / 0.08, transparent);
    border-radius: 6px;
    pointer-events: none;
  }
</style>
