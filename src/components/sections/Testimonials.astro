---
import { Star, Quote, ArrowRight } from '@lucide/astro';
import type { Testimonial } from '../../data/testimonials';

interface Props {
  testimonials: Testimonial[];
  title?: string;
  subtitle?: string;
  showAll?: boolean;
  variant?: 'cards' | 'carousel';
}

const { 
  testimonials, 
  title = 'What Our Clients Say',
  subtitle = 'Real results for real people',
  showAll = false,
  variant = 'cards'
} = Astro.props;

const displayTestimonials = showAll ? testimonials : testimonials.slice(0, 3);
---

<section class="section-padding bg-gray-50">
  <div class="container-custom">
    <div class="text-center max-w-3xl mx-auto mb-12">
      {subtitle && (
        <p class="text-gold-600 font-medium mb-2">{subtitle}</p>
      )}
      {title && (
        <h2 class="font-heading font-bold text-navy-900">{title}</h2>
      )}
      
      <!-- Aggregate Rating -->
      <div class="flex items-center justify-center gap-2 mt-4">
        <div class="flex">
          {[...Array(5)].map(() => (
            <Star class="w-5 h-5 text-gold-500 fill-gold-500" />
          ))}
        </div>
        <span class="font-semibold text-navy-900">5.0</span>
        <span class="text-gray-600">based on {testimonials.length} reviews</span>
      </div>
    </div>
    
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {displayTestimonials.map((testimonial) => (
        <div class="bg-white rounded-xl p-6 shadow-sm border border-gray-100 flex flex-col">
          <!-- Quote icon -->
          <Quote class="w-10 h-10 text-gold-500/20 mb-4" />
          
          <!-- Rating -->
          <div class="flex gap-1 mb-4">
            {[...Array(testimonial.rating)].map(() => (
              <Star class="w-4 h-4 text-gold-500 fill-gold-500" />
            ))}
          </div>
          
          <!-- Text -->
          <p class="text-gray-700 flex-grow mb-4 leading-relaxed">
            "{showAll ? testimonial.text : testimonial.shortText}"
          </p>
          
          <!-- Author -->
          <div class="flex items-center gap-3 pt-4 border-t border-gray-100">
            <div class="w-10 h-10 bg-navy-900 rounded-full flex items-center justify-center">
              <span class="text-gold-500 font-bold">
                {testimonial.name.charAt(0)}
              </span>
            </div>
            <div>
              <div class="font-semibold text-navy-900">{testimonial.name}</div>
              <div class="text-sm text-gray-500">{testimonial.location}</div>
            </div>
          </div>
          
          {testimonial.caseType && (
            <div class="mt-3">
              <span class="inline-block px-3 py-1 bg-gold-50 text-gold-700 text-xs font-medium rounded-full">
                {testimonial.caseType}
              </span>
            </div>
          )}
        </div>
      ))}
    </div>
    
    {!showAll && (
      <div class="text-center mt-10">
        <a href="/reviews/" class="btn btn-secondary">
          Read All Reviews
          <ArrowRight class="w-5 h-5" />
        </a>
      </div>
    )}
  </div>
</section>
