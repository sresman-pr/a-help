---
import { Star, Quote, ArrowRight } from '@lucide/astro';
import type { Testimonial } from '../../data/testimonials';

interface Props {
  testimonials: Testimonial[];
  title?: string;
  subtitle?: string;
  showAll?: boolean;
  variant?: 'cards' | 'carousel';
}

const { 
  testimonials, 
  title = 'What Our Clients Say',
  subtitle = 'Real results for real people',
  showAll = false,
  variant = 'cards'
} = Astro.props;

const displayTestimonials = showAll ? testimonials : testimonials.slice(0, 3);
---

<section class="section-padding bg-gray-50 relative overflow-hidden">
  <!-- Decorative Elements -->
  <div class="absolute inset-0 bg-pattern-grid opacity-30"></div>
  <div class="absolute top-20 right-10 w-64 h-64 rounded-full bg-gold-500/5 blur-3xl"></div>
  <div class="absolute bottom-20 left-10 w-48 h-48 rounded-full bg-navy-500/5 blur-3xl"></div>
  
  <div class="container-custom relative">
    <div class="text-center max-w-3xl mx-auto mb-12">
      {subtitle && (
        <p class="text-gold-600 font-medium mb-2">{subtitle}</p>
      )}
      {title && (
        <h2 class="font-heading font-bold text-navy-900">{title}</h2>
      )}
      
      <!-- Aggregate Rating -->
      <div class="inline-flex items-center gap-3 mt-6 bg-white px-6 py-3 rounded-full shadow-soft border border-gray-100">
        <div class="flex">
          {[...Array(5)].map(() => (
            <Star class="w-5 h-5 text-gold-500 fill-gold-500" />
          ))}
        </div>
        <span class="font-bold text-navy-900">5.0</span>
        <span class="text-gray-500 text-sm">based on {testimonials.length} reviews</span>
      </div>
    </div>
    
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {displayTestimonials.map((testimonial, index) => (
        <div 
          class="bg-white rounded-2xl p-6 shadow-soft border border-gray-100 flex flex-col card-modern group"
          style={`animation-delay: ${index * 100}ms`}
        >
          <!-- Quote icon with gradient -->
          <div class="relative mb-4">
            <Quote class="w-12 h-12 text-gold-500/20" />
            <div class="absolute top-0 left-0 w-12 h-12 bg-gradient-to-br from-gold-500/10 to-transparent rounded-full"></div>
          </div>
          
          <!-- Rating -->
          <div class="flex gap-1 mb-4">
            {[...Array(testimonial.rating)].map(() => (
              <Star class="w-4 h-4 text-gold-500 fill-gold-500" />
            ))}
          </div>
          
          <!-- Text -->
          <p class="text-gray-700 flex-grow mb-4 leading-relaxed">
            "{showAll ? testimonial.text : testimonial.shortText}"
          </p>
          
          <!-- Author -->
          <div class="flex items-center gap-3 pt-4 border-t border-gray-100">
            <div class="w-12 h-12 bg-gradient-to-br from-navy-800 to-navy-900 rounded-full flex items-center justify-center shadow-soft group-hover:scale-105 transition-transform">
              <span class="text-gold-500 font-bold">
                {testimonial.name.charAt(0)}
              </span>
            </div>
            <div>
              <div class="font-semibold text-navy-900">{testimonial.name}</div>
              <div class="text-sm text-gray-500">{testimonial.location}</div>
            </div>
          </div>
          
          {testimonial.caseType && (
            <div class="mt-3">
              <span class="inline-block px-3 py-1 bg-gradient-to-r from-gold-50 to-gold-100 text-gold-700 text-xs font-medium rounded-full border border-gold-200">
                {testimonial.caseType}
              </span>
            </div>
          )}
        </div>
      ))}
    </div>
    
    {!showAll && (
      <div class="text-center mt-10">
        <a href="/reviews/" class="btn btn-secondary btn-glow">
          Read All Reviews
          <ArrowRight class="w-5 h-5" />
        </a>
      </div>
    )}
  </div>
</section>
