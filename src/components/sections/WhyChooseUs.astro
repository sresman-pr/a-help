---
import { Award, Clock, Globe, DollarSign } from '@lucide/astro';

interface Props {
  title?: string;
  subtitle?: string;
}

const { 
  title = 'Why Choose Alex Poberesky',
  subtitle = 'Dedicated to your success'
} = Astro.props;

// Simplified to 4 key points (merged from TrustBar)
const stats = [
  {
    icon: 'Award',
    value: '26',
    suffix: '+',
    label: 'Years Experience',
    description: 'Over two decades fighting for Maryland families'
  },
  {
    icon: 'DollarSign',
    value: '0',
    suffix: '',
    label: 'No Fee Unless We Win',
    description: 'You pay nothing unless we recover compensation'
  },
  {
    icon: 'Clock',
    value: '24/7',
    suffix: '',
    label: 'Always Available',
    description: 'Accidents don\'t wait. Neither do we.'
  },
  {
    icon: 'Globe',
    value: '5',
    suffix: '',
    label: 'Languages Spoken',
    description: 'English, Russian, Ukrainian, Turkish, Uzbek'
  }
];

const iconComponents = { Award, Clock, Globe, DollarSign };
---

<section class="section-padding section-dark relative overflow-hidden" id="why-choose-us">
  <!-- Subtle background texture -->
  <div class="absolute inset-0 bg-pattern-grid-light opacity-5"></div>
  
  <div class="container-custom relative">
    <div class="text-center max-w-3xl mx-auto mb-16 fade-in-up">
      {subtitle && (
        <p class="text-gold-400 font-medium mb-3 text-lg">{subtitle}</p>
      )}
      {title && (
        <h2 class="font-heading font-bold text-white">{title}</h2>
      )}
    </div>
    
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-6 lg:gap-8 stagger-children">
      {stats.map((stat, index) => {
        const IconComponent = iconComponents[stat.icon as keyof typeof iconComponents];
        const isCountable = stat.value !== '24/7' && stat.value !== '0';
        
        return (
          <div class="text-center p-4 sm:p-6 lg:p-8 bg-white/5 backdrop-blur-sm rounded-2xl border border-white/10 fade-in-up">
            <div class="w-12 h-12 sm:w-16 sm:h-16 bg-gold-500 rounded-2xl flex items-center justify-center mx-auto mb-4 sm:mb-5 shadow-lg">
              <IconComponent class="w-6 h-6 sm:w-8 sm:h-8 text-navy-900" />
            </div>
            
            <div class="stat-number text-3xl sm:text-4xl lg:text-5xl mb-2">
              {isCountable ? (
                <span class="counter-animate" data-target={stat.value}>{stat.value}</span>
              ) : (
                stat.value
              )}
              {stat.suffix}
            </div>
            
            <h3 class="font-bold text-white text-base sm:text-lg mb-2">{stat.label}</h3>
            <p class="text-gray-400 text-xs sm:text-sm">{stat.description}</p>
          </div>
        );
      })}
    </div>
  </div>
</section>
