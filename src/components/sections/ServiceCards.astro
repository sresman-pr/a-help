---
import { ArrowRight, Car, Truck, Bike, Shield, Scale, AlertTriangle, Stethoscope, HardHat, Dog, Heart, Package, Home, Building, Footprints, Lock, Pill, Smile } from '@lucide/astro';
import type { Service } from '../../data/services';

interface Props {
  services: Service[];
  title?: string;
  subtitle?: string;
  columns?: 2 | 3 | 4 | 5;
  showDescription?: boolean;
  variant?: 'default' | 'image-cards';
}

const { 
  services, 
  title,
  subtitle,
  columns = 3,
  showDescription = true,
  variant = 'image-cards'
} = Astro.props;

const iconComponents = {
  Car, Truck, Bike, Shield, Scale, AlertTriangle, Stethoscope, HardHat, 
  Dog, Heart, Package, Home, Building, Footprints, Lock, Pill, Smile
};

const gridCols = {
  2: 'grid-cols-2',
  3: 'grid-cols-2 lg:grid-cols-3',
  4: 'grid-cols-2 lg:grid-cols-4',
  5: 'grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-5'
};
---

<section class="section-padding section-light relative overflow-hidden">
  <div class="container-custom relative">
    {(title || subtitle) && (
      <div class="text-center max-w-3xl mx-auto mb-14 fade-in-up">
        {subtitle && (
          <p class="text-gold-600 font-medium mb-3 text-lg">{subtitle}</p>
        )}
        {title && (
          <h2 class="font-heading font-bold text-navy-900">{title}</h2>
        )}
      </div>
    )}
    
    <div class={`grid ${gridCols[columns]} gap-4 stagger-children`}>
      {services.map((service, index) => {
        const IconComponent = iconComponents[service.icon as keyof typeof iconComponents] || Shield;
        
        return (
          /* Clean card matching original site style */
          <a 
            href={service.href}
            class="group relative bg-navy-900 rounded-xl overflow-hidden shadow-lg hover:shadow-xl transition-all duration-300 fade-in-up"
          >
            {/* Card content */}
            <div class="p-4 sm:p-5 text-center flex flex-col items-center justify-center min-h-[140px] sm:min-h-[160px]">
              <div class="w-14 h-14 bg-gold-500 rounded-full flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
                <IconComponent class="w-7 h-7 text-navy-900" />
              </div>
              <h3 class="font-heading font-bold text-base lg:text-lg text-white leading-tight group-hover:text-gold-400 transition-colors">
                {service.title}
              </h3>
            </div>
            
            {/* Bottom accent */}
            <div class="h-1 bg-gold-500 transform scale-x-0 group-hover:scale-x-100 transition-transform origin-left"></div>
          </a>
        );
      })}
    </div>
  </div>
</section>
