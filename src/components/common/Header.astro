---
import { Phone, Menu, X, ChevronDown, Globe } from '@lucide/astro';
import { mainNavigation, contactInfo } from '../../data/navigation';

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-50 bg-white shadow-sm">
  <!-- Top bar with phone and languages -->
  <div class="bg-navy-900 text-white py-2">
    <div class="container-custom flex items-center justify-between text-sm">
      <div class="flex items-center gap-4">
        <a href={`tel:${contactInfo.phoneRaw}`} class="flex items-center gap-2 hover:text-gold-400 transition-colors">
          <Phone class="w-4 h-4" />
          <span class="font-semibold">{contactInfo.phone}</span>
        </a>
        <span class="hidden sm:inline text-gray-400">|</span>
        <span class="hidden sm:inline text-gray-300">{contactInfo.hours}</span>
      </div>
      <div class="hidden md:flex items-center gap-2 text-gray-300">
        <Globe class="w-4 h-4" />
        <span>We speak: {contactInfo.languages.slice(0, 3).join(', ')} & more</span>
      </div>
    </div>
  </div>
  
  <!-- Main navigation -->
  <nav class="container-custom py-4">
    <div class="flex items-center justify-between">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-3">
        <img 
          src="https://www.alexhelp.com/wp-content/uploads/2022/09/cropped-cropped-Banner-Logo.png" 
          alt="Law Offices of Alex Poberesky" 
          class="h-12 w-auto"
        />
        <div class="hidden sm:block">
          <div class="font-heading font-bold text-navy-900 text-lg leading-tight">Law Offices of</div>
          <div class="font-heading font-bold text-gold-600 text-lg leading-tight">Alex Poberesky</div>
        </div>
      </a>
      
      <!-- Desktop Navigation -->
      <div class="hidden lg:flex items-center gap-1">
        {mainNavigation.map((item) => (
          <div class="relative group">
            <a 
              href={item.href}
              class={`flex items-center gap-1 px-4 py-2 rounded-lg font-medium transition-colors ${
                currentPath.startsWith(item.href) && item.href !== '/' 
                  ? 'text-gold-600' 
                  : 'text-gray-700 hover:text-gold-600 hover:bg-gray-50'
              }`}
            >
              {item.label}
              {item.children && <ChevronDown class="w-4 h-4" />}
            </a>
            
            {item.children && (
              <div class="absolute top-full left-0 pt-2 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200">
                <div class="bg-white rounded-lg shadow-xl border border-gray-100 py-2 min-w-[220px]">
                  {item.children.map((child) => (
                    <a 
                      href={child.href}
                      class={`block px-4 py-2 text-sm transition-colors ${
                        currentPath === child.href 
                          ? 'text-gold-600 bg-gold-50' 
                          : 'text-gray-700 hover:text-gold-600 hover:bg-gray-50'
                      }`}
                    >
                      {child.label}
                    </a>
                  ))}
                </div>
              </div>
            )}
          </div>
        ))}
      </div>
      
      <!-- CTA Button (Desktop) -->
      <div class="hidden lg:flex items-center gap-4">
        <a href="/contact-us/" class="btn btn-primary">
          Free Consultation
        </a>
      </div>
      
      <!-- Mobile Menu Button -->
      <button 
        id="mobile-menu-button"
        class="lg:hidden p-2 rounded-lg hover:bg-gray-100 transition-colors"
        aria-label="Toggle menu"
        aria-expanded="false"
      >
        <Menu class="w-6 h-6 menu-open" />
        <X class="w-6 h-6 menu-close hidden" />
      </button>
    </div>
  </nav>
  
  <!-- Mobile Navigation -->
  <div id="mobile-menu" class="lg:hidden hidden border-t border-gray-100">
    <div class="container-custom py-4 space-y-2">
      {mainNavigation.map((item) => (
        <div class="mobile-nav-group">
          <button 
            class="mobile-nav-toggle w-full flex items-center justify-between p-3 rounded-lg hover:bg-gray-50 transition-colors"
            data-has-children={item.children ? 'true' : 'false'}
          >
            <a href={item.href} class="font-medium text-gray-800">{item.label}</a>
            {item.children && <ChevronDown class="w-5 h-5 text-gray-400 transition-transform" />}
          </button>
          
          {item.children && (
            <div class="mobile-nav-children hidden pl-4 space-y-1">
              {item.children.map((child) => (
                <a 
                  href={child.href}
                  class="block p-2 text-sm text-gray-600 hover:text-gold-600 rounded-lg hover:bg-gray-50 transition-colors"
                >
                  {child.label}
                </a>
              ))}
            </div>
          )}
        </div>
      ))}
      
      <div class="pt-4 border-t border-gray-100">
        <a href="/contact-us/" class="btn btn-primary w-full">
          Free Consultation
        </a>
        <a 
          href={`tel:${contactInfo.phoneRaw}`} 
          class="btn btn-secondary w-full mt-2"
        >
          <Phone class="w-5 h-5" />
          Call {contactInfo.phone}
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  // Mobile menu toggle
  const menuButton = document.getElementById('mobile-menu-button');
  const mobileMenu = document.getElementById('mobile-menu');
  const menuOpenIcon = menuButton?.querySelector('.menu-open');
  const menuCloseIcon = menuButton?.querySelector('.menu-close');
  
  menuButton?.addEventListener('click', () => {
    const isOpen = mobileMenu?.classList.toggle('hidden');
    menuOpenIcon?.classList.toggle('hidden');
    menuCloseIcon?.classList.toggle('hidden');
    menuButton.setAttribute('aria-expanded', String(!isOpen));
  });
  
  // Mobile submenu toggles
  const mobileNavToggles = document.querySelectorAll('.mobile-nav-toggle');
  mobileNavToggles.forEach((toggle) => {
    toggle.addEventListener('click', (e) => {
      const hasChildren = toggle.getAttribute('data-has-children') === 'true';
      if (!hasChildren) return;
      
      e.preventDefault();
      const children = toggle.nextElementSibling;
      const chevron = toggle.querySelector('svg:last-child');
      
      children?.classList.toggle('hidden');
      chevron?.classList.toggle('rotate-180');
    });
  });
</script>
