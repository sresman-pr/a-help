---
import { ChevronRight, Home } from '@lucide/astro';

interface BreadcrumbItem {
  label: string;
  href?: string;
}

interface Props {
  items: BreadcrumbItem[];
  showHome?: boolean;
}

const { items, showHome = true } = Astro.props;

const allItems = showHome 
  ? [{ label: 'Home', href: '/' }, ...items]
  : items;

// Generate BreadcrumbList Schema
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": allItems.map((item, index) => ({
    "@type": "ListItem",
    "position": index + 1,
    "name": item.label,
    "item": item.href ? `https://www.alexhelp.com${item.href}` : undefined
  }))
};
---

<nav aria-label="Breadcrumb" class="py-4">
  <div class="container-custom">
    <ol class="flex items-center flex-wrap gap-2 text-sm">
      {allItems.map((item, index) => (
        <li class="flex items-center">
          {index > 0 && (
            <ChevronRight class="w-4 h-4 text-gray-400 mx-2" />
          )}
          {item.href && index < allItems.length - 1 ? (
            <a 
              href={item.href} 
              class="text-gray-600 hover:text-gold-600 transition-colors flex items-center gap-1"
            >
              {index === 0 && showHome && <Home class="w-4 h-4" />}
              {item.label}
            </a>
          ) : (
            <span class="text-navy-900 font-medium flex items-center gap-1">
              {index === 0 && showHome && <Home class="w-4 h-4" />}
              {item.label}
            </span>
          )}
        </li>
      ))}
    </ol>
  </div>
</nav>

<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
