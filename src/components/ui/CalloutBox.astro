---
import { AlertTriangle, Info, CheckCircle, AlertCircle } from '@lucide/astro';

interface Props {
  title?: string;
  variant?: 'info' | 'warning' | 'success' | 'navy';
  icon?: 'alert' | 'info' | 'check' | 'warning';
}

const { 
  title,
  variant = 'info',
  icon
} = Astro.props;

const variantStyles = {
  info: 'bg-navy-900/5 border-navy-500/30 text-navy-900',
  warning: 'bg-gold-500/10 border-gold-500/50 text-navy-900',
  success: 'bg-green-50 border-green-500/30 text-green-900',
  navy: 'bg-navy-900 border-navy-700 text-white'
};

const iconStyles = {
  info: 'text-navy-600',
  warning: 'text-gold-600',
  success: 'text-green-600',
  navy: 'text-gold-400'
};

const titleStyles = {
  info: 'text-navy-900',
  warning: 'text-navy-900',
  success: 'text-green-900',
  navy: 'text-white'
};

const iconComponents = {
  alert: AlertCircle,
  info: Info,
  check: CheckCircle,
  warning: AlertTriangle
};

// Default icons per variant
const defaultIcons = {
  info: 'info',
  warning: 'warning',
  success: 'check',
  navy: 'info'
};

const selectedIcon = icon || defaultIcons[variant];
const IconComponent = iconComponents[selectedIcon as keyof typeof iconComponents];
---

<div class={`rounded-xl border-l-4 p-5 md:p-6 my-8 ${variantStyles[variant]}`}>
  <div class="flex gap-4">
    <div class={`flex-shrink-0 ${iconStyles[variant]}`}>
      <IconComponent class="w-6 h-6" />
    </div>
    <div class="flex-grow">
      {title && (
        <h4 class={`font-heading font-bold text-lg mb-2 ${titleStyles[variant]}`}>
          {title}
        </h4>
      )}
      <div class={`prose prose-sm max-w-none ${variant === 'navy' ? 'text-gray-300' : 'text-gray-700'}`}>
        <slot />
      </div>
    </div>
  </div>
</div>
