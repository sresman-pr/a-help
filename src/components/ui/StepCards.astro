---
interface Step {
  title: string;
  description: string;
}

interface Props {
  steps: Step[];
  columns?: 2 | 3 | 4;
  variant?: 'numbered' | 'timeline';
}

const { 
  steps, 
  columns = 3,
  variant = 'numbered'
} = Astro.props;

const gridCols = {
  2: 'md:grid-cols-2',
  3: 'md:grid-cols-2 lg:grid-cols-3',
  4: 'md:grid-cols-2 lg:grid-cols-4'
};
---

{variant === 'numbered' ? (
  <div class={`grid grid-cols-1 ${gridCols[columns]} gap-4 my-8`}>
    {steps.map((step, index) => (
      <div class="bg-white rounded-xl p-5 border border-gray-100 shadow-soft hover:shadow-elevated transition-shadow">
        <div class="flex items-start gap-4">
          <div class="w-10 h-10 bg-navy-900 rounded-lg flex items-center justify-center flex-shrink-0">
            <span class="text-gold-400 font-bold text-lg">{index + 1}</span>
          </div>
          <div>
            <h4 class="font-bold text-navy-900 mb-1">{step.title}</h4>
            <p class="text-sm text-gray-600">{step.description}</p>
          </div>
        </div>
      </div>
    ))}
  </div>
) : (
  <div class="my-8 relative">
    {/* Timeline line */}
    <div class="absolute left-5 top-0 bottom-0 w-0.5 bg-gold-500/30 hidden md:block"></div>
    
    <div class="space-y-6">
      {steps.map((step, index) => (
        <div class="relative flex gap-6">
          {/* Timeline marker */}
          <div class="hidden md:flex w-10 h-10 bg-gold-500 rounded-full items-center justify-center flex-shrink-0 z-10 shadow-lg">
            <span class="text-navy-900 font-bold">{index + 1}</span>
          </div>
          
          {/* Mobile number */}
          <div class="md:hidden w-8 h-8 bg-gold-500 rounded-full flex items-center justify-center flex-shrink-0">
            <span class="text-navy-900 font-bold text-sm">{index + 1}</span>
          </div>
          
          {/* Content */}
          <div class="flex-grow bg-white rounded-xl p-5 border border-gray-100 shadow-soft">
            <h4 class="font-bold text-navy-900 mb-2">{step.title}</h4>
            <p class="text-gray-600">{step.description}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
)}
