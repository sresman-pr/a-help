---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'a'> {
  variant?: 'primary' | 'secondary' | 'outline' | 'ghost';
  size?: 'sm' | 'md' | 'lg';
  href?: string;
  fullWidth?: boolean;
}

const { 
  variant = 'primary', 
  size = 'md', 
  href, 
  fullWidth = false,
  class: className,
  ...rest 
} = Astro.props;

const baseClasses = 'inline-flex items-center justify-center gap-2 font-semibold rounded-lg transition-all duration-200 cursor-pointer';

const variantClasses = {
  primary: 'bg-gold-500 text-navy-900 hover:bg-gold-400 hover:-translate-y-0.5',
  secondary: 'bg-navy-800 text-white hover:bg-navy-700 hover:-translate-y-0.5',
  outline: 'border-2 border-gold-500 text-gold-600 hover:bg-gold-500 hover:text-navy-900',
  ghost: 'text-gray-700 hover:bg-gray-100 hover:text-navy-900'
};

const sizeClasses = {
  sm: 'px-4 py-2 text-sm',
  md: 'px-6 py-3 text-base',
  lg: 'px-8 py-4 text-lg'
};

const classes = [
  baseClasses,
  variantClasses[variant],
  sizeClasses[size],
  fullWidth && 'w-full',
  className
].filter(Boolean).join(' ');

const Tag = href ? 'a' : 'button';
---

<Tag href={href} class={classes} {...rest}>
  <slot />
</Tag>
